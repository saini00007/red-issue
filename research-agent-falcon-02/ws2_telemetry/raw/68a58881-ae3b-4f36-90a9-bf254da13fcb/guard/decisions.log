{"ts": 1790640470.6373901, "decision_id": "909ef1532857", "tool": "run_shell", "allow": false, "reason": "out-of-scope target blocked: test.local", "target": "cd /work && cat > register_accounts.py << 'EOF'\nimport requests\nimport json\nimport sys\n\nBASE_URL = \"https://duck-store.escape.tech/api/v1\"\n\ndef register_user(email, password, username):\n    url = f\"{BASE_URL}/auth/register\"\n    data = {\n        \"email\": email,\n        \"password\": password,\n        \"username\": username\n    }\n    resp = requests.post(url, json=data, timeout=30)\n    return resp\n\ndef login_user(email, password):\n    url = f\"{BASE_URL}/auth/login\"\n    data = {\n        \"email\": email,\n        \"password\": password\n    }\n    resp = requests.post(url, json=data, timeout=30)\n    return resp\n\n# Register user_a\nemail_a = \"usera@test.local\"\npassword_a = \"TestPass123!\"\nusername_a = \"usera_test\"\n\nprint(f\"Registering user_a: {email_a}\")\nresp = register_user(email_a, password_a, username_a)\nprint(f\"Register response: {resp.status_code} - {resp.text}\")\n\n# Register user_b\nemail_b = \"userb@test.local\"\npassword_b = \"TestPass123!\"\nusername_b = \"userb_test\"\n\nprint(f\"Registering user_b: {email_b}\")\nresp = register_user(email_b, password_b, username_b)\nprint(f\"Register response: {resp.status_code} - {resp.text}\")\n\n# Login user_a\nprint(f\"Logging in user_a\")\nresp = login_user(email_a, password_a)\nprint(f\"Login response: {resp.status_code} - {resp.text}\")\nif resp.status_code == 200:\n    token_a = resp.json().get('access_token') or resp.json().get('token')\n    print(f\"Token A: {token_a}\")\n\n# Login user_b\nprint(f\"Logging in user_b\")\nresp = login_user(email_b, password_b)\nprint(f\"Login response: {resp.status_code} - {resp.text}\")\nif resp.status_code == 200:\n    token_b = resp.json().get('access_token') or resp.json().get('token')\n    print(f\"Token B: {token_b}\")\n\n# Save auth.json\nauth_data = {\n    \"user_a\": {\n        \"email\": email_a,\n        \"password\": password_a,\n        \"username\": username_a,\n        \"access_token\": token_a if 'token_a' in locals() else None\n    },\n    \"user_b\": {\n        \"email\": email_b,\n        \"password\": password_b,\n        \"username\": username_b,\n        \"access_token\": token_b if 'token_b' in locals() else None\n    }\n}\n\nwith open('/work/auth.json', 'w') as f:\n    json.dump(auth_data, f, indent=2)\n\nprint(\"Saved /work/auth.json\")\nEOF\npython3 register_accounts.py"}
