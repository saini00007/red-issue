{"ts": 1790670379.4003766, "decision_id": "e517e564333b", "tool": "run_shell", "allow": true, "reason": null, "target": "cat > /work/login_fixed.py << 'EOF'\nimport requests\nimport json\nimport time\n\nBASE_URL = \"https://duck-store.escape.tech/api/v1\"\n\ndef login_user(username, password):\n    url = f\"{BASE_URL}/auth/login\"\n    data = {\n        \"username\": username,\n        \"password\": password\n    }\n    resp = requests.post(url, json=data, timeout=30)\n    return resp\n\n# Use the usernames from register\ntimestamp = 1790670361\nusername_a = f\"usera_{timestamp}\"\npassword_a = \"TestPass123!\"\n\nprint(f\"Logging in user_a: {username_a}\")\nresp = login_user(username_a, password_a)\nprint(f\"Login response: {resp.status_code} - {resp.text}\")\nif resp.status_code == 200:\n    token_a = resp.json().get('access_token') or resp.json().get('token')\n    print(f\"Token A: {token_a}\")\n\n# Login user_b\nusername_b = f\"userb_{timestamp}\"\npassword_b = \"TestPass123!\"\n\nprint(f\"Logging in user_b: {username_b}\")\nresp = login_user(username_b, password_b)\nprint(f\"Login response: {resp.status_code} - {resp.text}\")\nif resp.status_code == 200:\n    token_b = resp.json().get('access_token') or resp.json().get('token')\n    print(f\"Token B: {token_b}\")\n\n# Update auth.json\nwith open('/work/auth.json', 'r') as f:\n    auth_data = json.load(f)\n\nif 'token_a' in locals():\n    auth_data['user_a']['access_token'] = token_a\n    auth_data['user_a']['username'] = username_a\n    auth_data['user_a']['id'] = resp.json().get('id')  # This won't work, need to get from login\nif 'token_b' in locals():\n    auth_data['user_b']['access_token'] = token_b\n    auth_data['user_b']['username'] = username_b\n\nwith open('/work/auth.json', 'w') as f:\n    json.dump(auth_data, f, indent=2)\n\nprint(\"Updated /work/auth.json\")\nEOF\npython3 /work/login_fixed.py"}
