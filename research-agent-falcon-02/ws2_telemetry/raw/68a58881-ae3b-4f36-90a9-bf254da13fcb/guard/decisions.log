_a.text[:500])\nprint()\n\n# Add to cart\ncart_data = {\"product_id\": 1, \"quantity\": 1}\nresp_a = requests.post(\"https://duck-store.escape.tech/api/v1/cart/add\", headers=headers_a, json=cart_data)\nprint(\"POST /api/v1/cart/add as user_a: \" + str(resp_a.status_code))\nprint(resp_a.text[:500])\nprint()\n\nresp_a = requests.get(\"https://duck-store.escape.tech/api/v1/cart\", headers=headers_a)\nprint(\"GET /api/v1/cart after add as user_a: \" + str(resp_a.status_code))\nprint(resp_a.text[:500])\nprint()\n\n# Test cart as user_b\nresp_b = requests.get(\"https://duck-store.escape.tech/api/v1/cart\", headers=headers_b)\nprint(\"GET /api/v1/cart as user_b: \" + str(resp_b.status_code))\nprint(resp_b.text[:500])\nPYEOF"}
