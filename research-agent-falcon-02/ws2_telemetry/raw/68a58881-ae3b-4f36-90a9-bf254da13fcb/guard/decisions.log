t(resp_a.text[:500])\nprint()\n\n# Test reviews more - try to create a review as user_a and access as user_b\nreview_data = {\"product_id\": 1, \"rating\": 4, \"title\": \"Good\", \"content\": \"Nice duck\"}\nresp_a = requests.post(\"https://duck-store.escape.tech/api/v1/reviews\", headers=headers_a, json=review_data)\nprint(\"POST /api/v1/reviews as user_a: \" + str(resp_a.status_code))\nprint(resp_a.text[:500])\nprint()\n\n# Check reviews list\nresp_a = requests.get(\"https://duck-store.escape.tech/api/v1/reviews/product/1?skip=0&limit=20\", headers=headers_a)\nprint(\"GET /api/v1/reviews/product/1 as user_a: \" + str(resp_a.status_code))\nprint(resp_a.text[:500])\nPYEOF"}
