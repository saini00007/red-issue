"Status: {resp.status_code}\")\n            print(f\"Response: {resp.text[:500]}\")\n            print(\"---\")\n            break\n        elif \"error\" in resp.text.lower() or \"sql\" in resp.text.lower() or \"syntax\" in resp.text.lower():\n            print(f\"Field: {field}, Payload: {payload} - Possible SQL error!\")\n            print(f\"Status: {resp.status_code}\")\n            print(f\"Response: {resp.text[:500]}\")\n            print(\"---\")\n            break\n    else:\n        print(f\"Field {field}: all payloads returned 422/400\")\nEOF"}
