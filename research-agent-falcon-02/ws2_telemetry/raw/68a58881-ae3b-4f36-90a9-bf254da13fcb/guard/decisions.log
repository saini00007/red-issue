{"ts": 1790652018.7203107, "decision_id": "9c5a6ddd567e", "tool": "run_shell", "allow": true, "reason": null, "target": "python3 -c \"\nimport requests\nimport json\n\nBASE_URL = 'https://duck-store.escape.tech/api/v1'\n\ndef login_user(username, password):\n    url = f'{BASE_URL}/auth/login'\n    data = {\n        'username': username,\n        'password': password\n    }\n    resp = requests.post(url, json=data, timeout=30)\n    return resp\n\n# Login user_a\nprint('Logging in user_a')\nresp = login_user('usera_1790651968', 'TestPass123!')\nprint(f'Login response: {resp.status_code} - {resp.text}')\nif resp.status_code == 200:\n    token_a = resp.json().get('access_token') or resp.json().get('token')\n    print(f'Token A: {token_a}')\n\n# Login user_b\nprint('Logging in user_b')\nresp = login_user('userb_1790651968', 'TestPass123!')\nprint(f'Login response: {resp.status_code} - {resp.text}')\nif resp.status_code == 200:\n    token_b = resp.json().get('access_token') or resp.json().get('token')\n    print(f'Token B: {token_b}')\n\""}
