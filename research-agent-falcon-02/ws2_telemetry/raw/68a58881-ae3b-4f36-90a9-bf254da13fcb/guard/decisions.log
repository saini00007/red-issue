{"ts": 1790645512.4566777, "decision_id": "f13d237d8df9", "tool": "run_shell", "allow": true, "reason": null, "target": "cd /work && python3 << 'PYEOF'\nimport requests\nimport json\n\n# Test with regular user tokens\ntoken_a = \"eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJ1c2VyX2lkIjoiZjA1MTIwOWYtN2JhOS00NTM0LTk2MDctOGU0Y2VkZThlYWZhIiwidXNlcm5hbWUiOiJ1c2VyYV90ZXN0MiIsInJvbGUiOiJ1c2VyIiwiZXhwIjoxNzkwNjQ2NDAwfQ.jjm1FNMyQsfAxt3FEemcaRAUeX9QpHRpTSpgz3afX-I\"\ntoken_b = \"eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJ1c2VyX2lkIjoiNGI3ZGUyYjAtZGY5ZS00ODI5LTg5OTQtYTkyYmU0MzBkYmEyIiwidXNlcm5hbWUiOiJ1c2VyYl90ZXN0MiIsInJvbGUiOiJ1c2VyIiwiZXhwIjoxNzkwNjQ2NDEzfQ.KOnyrbtgKgrKsV-OdFw2pLS4HVZtm5LymUFbDPYz3vs\"\n\nheaders_a = {\"Authorization\": \"Bearer \" + token_a, \"Content-Type\": \"application/json\"}\nheaders_b = {\"Authorization\": \"Bearer \" + token_b, \"Content-Type\": \"application/json\"}\n\n# Test endpoints for IDOR/BOLA - check if they return user-specific data\nendpoints = [\n    \"https://duck-store.escape.tech/api/v1/products/?skip=0&limit=100\",\n    \"https://duck-store.escape.tech/api/v1/testimonials/?skip=0&limit=50&featured_only=false\",\n    \"https://duck-store.escape.tech/api/v1/reviews/product/1?skip=0&limit=20\",\n    \"https://duck-store.escape.tech/api/v1/reviews/product/10?skip=0&limit=20\",\n    \"https://duck-store.escape.tech/api/v1/products/2\",\n    \"https://duck-store.escape.tech/api/v1/products/filter/by-color?color=Black\",\n    \"https://duck-store.escape.tech/api/v1/reviews/product/1/stats\",\n]\n\nfor ep in endpoints:\n    resp_a = requests.get(ep, headers=headers_a)\n    resp_b = requests.get(ep, headers=headers_b)\n    print(\"Endpoint: \" + ep)\n    print(\"  user_a: \" + str(resp_a.status_code))\n    print(\"  user_b: \" + str(resp_b.status_code))\n    if resp_a.status_code == 200:\n        # Check if responses are identical (not user-specific)\n        if resp_a.text == resp_b.text:\n            print(\"  Response identical for both users (not user-specific)\")\n        else:\n            print(\"  *** DIFFERENT RESPONSES ***\")\n            print(\"  user_a: \" + resp_a.text[:300])\n            print(\"  user_b: \" + resp_b.text[:300])\n    print()\n\n# Test testimonials POST to see if we can create testimonials for other users\ntestimonial_data = {\"content\": \"Test testimonial\", \"rating\": 5}\nresp_a = requests.post(\"https://duck-store.escape.tech/api/v1/testimonials\", headers=headers_a, json=testimonial_data)\nprint(\"POST /api/v1/testimonials as user_a: \" + str(resp_a.status_code))\nprint(resp_a.text[:500])\nprint()\n\nresp_b = requests.post(\"https://duck-store.escape.tech/api/v1/testimonials\", headers=headers_b, json=testimonial_data)\nprint(\"POST /api/v1/testimonials as user_b: \" + str(resp_b.status_code))\nprint(resp_b.text[:500])\nPYEOF"}
