"Test City\",\n        \"zip_code\": \"12345\",\n        \"country\": \"US\"\n    }\n}\nresp_a = requests.post(\"https://duck-store.escape.tech/api/v1/orders/checkout\", headers=headers_a, json=order_data)\nprint(\"POST /api/v1/orders/checkout as user_a: \" + str(resp_a.status_code))\nprint(resp_a.text[:500])\nprint()\n\n# Check orders again\nresp_a = requests.get(\"https://duck-store.escape.tech/api/v1/orders/\", headers=headers_a)\nprint(\"GET /api/v1/orders/ after checkout as user_a: \" + str(resp_a.status_code))\nprint(resp_a.text[:500])\nprint()\n\n# Check if there's an order ID now\n# Try to access specific order\n# Also test coupons endpoint\nresp_a = requests.get(\"https://duck-store.escape.tech/api/v1/orders/coupons\", headers=headers_a)\nprint(\"GET /api/v1/orders/coupons as user_a: \" + str(resp_a.status_code))\nprint(resp_a.text[:500])\nprint()\n\nresp_b = requests.get(\"https://duck-store.escape.tech/api/v1/orders/coupons\", headers=headers_b)\nprint(\"GET /api/v1/orders/coupons as user_b: \" + str(resp_b.status_code))\nprint(resp_b.text[:500])\nPYEOF"}
