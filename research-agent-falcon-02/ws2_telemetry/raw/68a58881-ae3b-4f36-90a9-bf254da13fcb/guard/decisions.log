{"ts": 1790691595.5300364, "decision_id": "98e53a6bd7ac", "tool": "run_shell", "allow": true, "reason": null, "target": "python3 << 'EOF'\nimport requests\nimport json\nimport time\n\nBASE_URL = \"https://duck-store.escape.tech/api/v1\"\n\n# Register user_a\ntimestamp = int(time.time())\nemail_a = f\"usera{timestamp}@duck-store.escape.tech\"\npassword_a = \"TestPass123!\"\nusername_a = f\"usera_{timestamp}\"\n\nprint(f\"Registering user_a: {email_a}\")\nresp = requests.post(f\"{BASE_URL}/auth/register\", json={\"email\": email_a, \"password\": password_a, \"username\": username_a})\nprint(f\"Register response: {resp.status_code} - {resp.text}\")\n\n# Register user_b\nemail_b = f\"userb{timestamp}@duck-store.escape.tech\"\npassword_b = \"TestPass123!\"\nusername_b = f\"userb_{timestamp}\"\n\nprint(f\"Registering user_b: {email_b}\")\nresp = requests.post(f\"{BASE_URL}/auth/register\", json={\"email\": email_b, \"password\": password_b, \"username\": username_b})\nprint(f\"Register response: {resp.status_code} - {resp.text}\")\n\n# Login user_a\nprint(f\"Logging in user_a: {username_a}\")\nresp = requests.post(f\"{BASE_URL}/auth/login\", json={\"username\": username_a, \"password\": password_a})\nprint(f\"Login response: {resp.status_code} - {resp.text}\")\ntoken_a = resp.json().get('access_token') or resp.json().get('token')\nprint(f\"Token A: {token_a}\")\n\n# Login user_b\nprint(f\"Logging in user_b: {username_b}\")\nresp = requests.post(f\"{BASE_URL}/auth/login\", json={\"username\": username_b, \"password\": password_b})\nprint(f\"Login response: {resp.status_code} - {resp.text}\")\ntoken_b = resp.json().get('access_token') or resp.json().get('token')\nprint(f\"Token B: {token_b}\")\n\n# Save auth.json\nauth_data = {\n    \"user_a\": {\n        \"email\": email_a,\n        \"password\": password_a,\n        \"username\": username_a,\n        \"access_token\": token_a,\n        \"role\": \"user\"\n    },\n    \"user_b\": {\n        \"email\": email_b,\n        \"password\": password_b,\n        \"username\": username_b,\n        \"access_token\": token_b,\n        \"role\": \"user\"\n    }\n}\n\nwith open('/work/auth.json', 'w') as f:\n    json.dump(auth_data, f, indent=2)\n\nprint(\"Saved /work/auth.json\")\nEOF"}
