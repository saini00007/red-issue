{"ts": 1790739127.1972246, "decision_id": "b330e7cc5cf5", "tool": "run_shell", "allow": true, "reason": null, "target": "python3 - <<'EOF' 2>&1 | tail -80\nimport requests, re\nB=\"https://www.infinitycapital.bh\"\ns=requests.Session(); s.headers.update({\"User-Agent\":\"Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 Chrome/124.0 Safari/537.36\"})\nh=s.get(B+\"/\",timeout=30).text\njs=sorted(set(re.findall(r'/_next/static/[A-Za-z0-9_./\\-]+\\.js', h)))\nalljs=set(B+u for u in js); found=set(); texts={}\nfrontier=list(alljs)\nfor i in range(4):\n    nxt=[]\n    for u in frontier:\n        try: t=s.get(u,timeout=30).text\n        except Exception as e: continue\n        texts[u]=t\n        for x in re.findall(r'/_next/static/[A-Za-z0-9_./\\-]+\\.js',t):\n            if B+x not in texts and B+x not in nxt: nxt.append(B+x)\n        found.update(re.findall(r'/api/[A-Za-z0-9_./\\-]{1,60}',t))\n    frontier=[x for x in nxt]\nprint(\"total js fetched\",len(texts))\nopen('/tmp/jsdump.txt','w').write(\"\\n\\n\".join(f\"### {u}\\n{t}\" for u,t in texts.items()))\nprint(\"=== /api/ strings ===\"); [print(\" \",f) for f in sorted(found)]\nprint(\"=== auth/token keywords ===\")\nfor u,t in texts.items():\n    for kw in [\"Authorization\",\"Bearer\",\"jwt\",\"JWT\",\"session\",\"token\",\"login\",\"signIn\",\"admin\",\"NEXT_PUBLIC\",\"apiKey\",\"secret\"]:\n        if kw in t: print(f\"  {u.rsplit('/',1)[-1]}: {kw}\")\nEOF"}
{"ts": 1790739130.9856417, "decision_id": "4f9c6ba3d9bb", "tool": "run_shell", "allow": true, "reason": null, "target": "python3 - <<'EOF' 2>&1 | tail -80\nimport requests, re\nB=\"https://www.infinitycapital.bh\"\ns=requests.Session(); s.headers.update({\"User-Agent\":\"Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 Chrome/124.0 Safari/537.36\"})\nh=s.get(B+\"/\",timeout=30).text\njs=sorted(set(re.findall(r'/_next/static/[A-Za-z0-9_./\\-]+\\.js', h)))\nalljs=set(B+u for u in js); found=set(); texts={}\nfrontier=list(alljs)\nfor i in range(5):\n    nxt=[]\n    for u in frontier:\n        if u in texts: continue\n        try:\n            r=s.get(u,timeout=30)\n            if r.status_code!=200: \n                print(\"skip\",r.status_code,u); continue\n            t=r.text\n        except Exception as e:\n            print(\"err\",u,e); continue\n        texts[u]=t\n        for x in re.findall(r'/_next/static/[A-Za-z0-9_./\\-]+\\.js',t):\n            if B+x not in texts and B+x not in nxt: nxt.append(B+x)\n        found.update(re.findall(r'/api/[A-Za-z0-9_./\\-]{1,60}',t))\n    frontier=[x for x in nxt]\n    if not frontier: break\nprint(\"total js fetched\",len(texts))\nprint(\"=== /api/ strings ===\"); [print(\" \",f) for f in sorted(found)]\nprint(\"=== auth keywords ===\")\nfor u,t in texts.items():\n    hits=[kw for kw in [\"Authorization\",\"Bearer\",\"eyJ\",\"jwt\",\"JWT\",\"session\",\"token\",\"login\",\"admin\",\"apiKey\",\"secret\",\"api/send\"] if kw in t]\n    if hits: print(\" \",u.rsplit('/',1)[-1], hits)\nEOF"}
