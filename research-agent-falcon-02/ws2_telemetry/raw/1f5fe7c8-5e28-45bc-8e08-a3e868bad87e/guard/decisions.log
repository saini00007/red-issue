{"ts": 1790752491.792757, "decision_id": "11d51cca3fe1", "tool": "run_shell", "allow": true, "reason": null, "target": "cd /work/evidence && cat > burst.py <<'EOF'\nimport subprocess, urllib.parse, json, time, datetime\nB=\"https://www.infinitycapital.bh\"\nUA=\"Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/122.0 Safari/537.36\"\ndef form(f): return \"&\".join(\"%s=%s\"%(k,urllib.parse.quote(str(v),safe=\"\")) for k,v in f.items())\ndef send(f):\n    cmd=[\"curl\",\"-sk\",\"-X\",\"POST\",\"-A\",UA,\"-o\",\"/tmp/b.bin\",\"-w\",\"%{http_code}|%{time_total}\",\n         \"-H\",\"Content-Type: application/x-www-form-urlencoded\",\"-H\",\"Referer: \"+B+\"/contact\",\n         \"--data-binary\",form(f),B+\"/api/send\"]\n    r=subprocess.run(cmd,capture_output=True,text=True)\n    body=open(\"/tmp/b.bin\",\"rb\").read()\n    code,tt=r.stdout.split(\"|\")\n    try: j=json.loads(body)\n    except Exception: return code,float(tt),\"RAW:\"+repr(body[:60])\n    e=j.get(\"error\")\n    if e: return code,float(tt),(\"DENY[%s] \"%e.get(\"name\"))+str(e.get(\"message\"))[:60]\n    if j.get(\"data\") and j[\"data\"].get(\"id\"): return code,float(tt),\"ACCEPTED id=\"+j[\"data\"][\"id\"]\n    return code,float(tt),\"OTHER:\"+repr(j)[:60]\ndef mk(n):\n    return {\"fname\":\"Verify\",\"lname\":\"Bot\",\"areacode\":\"973\",\"tel\":\"5551234\",\n            \"cname\":\"Verify Tester\",\"subject\":\"Rate-limit check %d\"%n,\n            \"msg\":\"Automated verification of missing anti-automation controls.\",\n            \"check\":\"\",\"targets\":\"verify@pentest-activator.invalid\"}\nt0=time.time()\nprint(\"Burst: 12 POSTs, 1.0s apart, no delay > 1s, one IP, no cookies, no captcha token, empty honeypot\")\nfor i in range(12):\n    c,tt,res=send(mk(i))\n    print(\"  [%02d] +%5.1fs  HTTP %s  tt=%.2f  %s\"%(i+1,time.time()-t0,c,tt,res))\n    time.sleep(1.0)\nprint(\"Total wall time: %.1fs\"%(time.time()-t0))\nEOF\npython3 burst.py 2>&1 | tee burst.out"}
