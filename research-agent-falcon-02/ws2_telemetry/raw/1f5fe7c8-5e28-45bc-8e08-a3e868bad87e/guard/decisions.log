{"ts": 1790732597.752166, "decision_id": "48fe6b543500", "tool": "run_shell", "allow": true, "reason": null, "target": "cat > /work/d13/relay.py <<'PY'\nimport re,subprocess,sys\nh=open('/work/d13/contact.html',encoding='utf8',errors='replace').read()\nGOOD=re.search(r'targets..:.?..(.+?@.+?)..',h).group(1)\nGOOD=GOOD.replace('\\\\','')\nprint(\"legit target from CMS:\",GOOD)\nV=140\nUA=f\"Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/{V}.0.0.0 Safari/537.36\"\nB=\"https://www.infinitycapital.bh\"\ndef post(fields, extra=()):\n    a=[\"curl\",\"-sk\",\"-m\",\"40\",\"--http1.1\",\"-A\",UA,\n       \"-H\",\"Accept: */*\",\"-H\",\"Accept-Language: en-US,en;q=0.9\",\n       \"-H\",f\"Origin: {B}\",\"-H\",f\"Referer: {B}/contact\",\n       \"-X\",\"POST\",B+\"/api/send\",\"-w\",\"\\nHTTP=%{http_code}\\n\"]\n    for k,v in fields: a+=[\"-F\",f\"{k}={v}\"]\n    a+=list(extra)\n    r=subprocess.run(a,capture_output=True,text=True)\n    return r.stdout+r.stderr\nbase=[(\"fname\",\"Test\"),(\"lname\",\"User\"),(\"areacode\",\"+973\"),(\"tel\",\"12345678\"),\n      (\"cname\",\"Probe\"),(\"subject\",\"Investment Opportunities\"),(\"msg\",\"hello world\"),(\"check\",\"on\")]\nprint(\"\\n--- 1) legit recipient ---\");print(post(base+[(\"targets\",GOOD)]))\nprint(\"--- 2) check omitted ---\");print(post([f for f in base if f[0]!=\"check\"]+[(\"targets\",GOOD)]))\nprint(\"--- 3) no targets ---\");print(post(base))\nprint(\"--- 4) targets empty ---\");print(post(base+[(\"targets\",\"\")]))\nPY\npython3 /work/d13/relay.py"}
