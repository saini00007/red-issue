{"ts": 1790718602.3620608, "decision_id": "421f52dcccfd", "tool": "run_shell", "allow": true, "reason": null, "target": "cd \"$WORK_PATH\" && python3 -c \"\nimport json\n# Is there ANY interaction whose source is not the scanner itself?\n# The scanner's own probes use UA curl/8.21.0 and are http GET /.\n# A real target callback would come from Vercel/AWS infra, different UA / no UA, or a specific path.\nuas={}\npaths={}\nfor l in open('oob_interactions.jsonl'):\n    d=json.loads(l)\n    rr=d.get('raw-request','')\n    import re\n    ua=re.search(r'User-Agent: (.*?)\\\\\\\\r',rr)\n    pa=re.search(r'(GET|POST) (\\S+)',rr)\n    u=ua.group(1) if ua else ('DNS' if d.get('protocol')=='dns' else 'none')\n    p=pa.group(2) if pa else ('DNSQ:'+str(d.get('q-type')) if d.get('protocol')=='dns' else '?')\n    uas[u]=uas.get(u,0)+1\n    paths[p]=paths.get(p,0)+1\nprint('--- UserAgents ---')\nfor k,v in sorted(uas.items(),key=lambda x:-x[1]): print(f'{v:5d}  {k}')\nprint()\nprint('--- paths/queries ---')\nfor k,v in sorted(paths.items(),key=lambda x:-x[1])[:25]: print(f'{v:5d}  {k}')\n\""}
