{"ts": 1790731331.8068635, "decision_id": "305fc6b6f5a7", "tool": "run_shell", "allow": true, "reason": null, "target": "cd \"$WORK_PATH\"; python3 - <<'PY'\nimport json, collections\nreg={}\nfor l in open('oob_registry.jsonl'):\n    try:\n        d=json.loads(l); reg[d['token']]=d\n    except: pass\nbyfull=collections.defaultdict(lambda: {'n':0,'proto':collections.Counter(),'ip':collections.Counter(),'t':None})\nfor l in open('oob_interactions.jsonl'):\n    try: d=json.loads(l)\n    except: continue\n    f=d.get('full-id','')\n    pre=f.split('.')[0]\n    e=byfull[pre]\n    e['n']+=1; e['proto'][d.get('protocol')]+=1; e['ip'][d.get('remote-address')]+=1\n    if e['t'] is None: e['t']=d.get('timestamp')\nprint(\"distinct full-id prefixes:\",len(byfull))\nmatched=[(p,e) for p,e in byfull.items() if p in reg]\nprint(\"prefixes matching a REGISTERED token:\",len(matched))\nfor p,e in matched[:40]:\n    r=reg[p]\n    print(f\"  {p} n={e['n']} proto={dict(e['proto'])} ip={dict(e['ip'])} class={r.get('vuln_class')} ep={r.get('endpoint')}\")\nprint(\"--- all prefixes sample ---\")\nfor p,e in list(byfull.items())[:15]:\n    print(f\"  {p} n={e['n']} proto={dict(e['proto'])} ip={dict(e['ip'])}\")\nprint(\"--- total remote IPs ---\")\nallip=collections.Counter()\nfor e in byfull.values(): allip.update(e['ip'])\nfor ip,c in allip.most_common(15): print(\"  \",ip,c)\nPY"}
