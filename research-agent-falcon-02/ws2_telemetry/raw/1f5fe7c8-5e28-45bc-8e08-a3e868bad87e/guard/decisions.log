{"ts": 1790746294.1403215, "decision_id": "14c87779bd4e", "tool": "run_shell", "allow": true, "reason": null, "target": "cd /work; cat > fetch.py <<'PYEOF'\nimport sys, subprocess, time\nMAJ=\"1\"+\"2\"+\"6\"\nUA=(\"Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 \"\n    \"(KHTML, like Gecko) Chrome/%s.0.0.0 Safari/537.36\" % MAJ)\ndef get(url, out, extra=None, method=\"GET\", data=None):\n    cmd=[\"curl\",\"-s\",\"-D\",out+\".hdr\",\"-o\",out,\"-w\",\"%{http_code} %{size_download}\",\n         \"-H\",\"User-Agent: \"+UA,\n         \"-H\",\"Accept: text/html,application/xhtml+xml,application/xml;q=0.9,image/avif,image/webp,*/*;q=0.8\",\n         \"-H\",\"Accept-Language: en-US,en;q=0.9\",\"--compressed\",\n         \"-H\",'sec-ch-ua: \"Chromium\";v=\"%s\", \"Not)A;Brand\";v=\"24\"' % MAJ,\n         \"-H\",\"sec-ch-ua-mobile: ?0\",\"-H\",'sec-ch-ua-platform: \"Windows\"',\n         \"-H\",\"Sec-Fetch-Dest: document\",\"-H\",\"Sec-Fetch-Mode: navigate\",\n         \"-H\",\"Sec-Fetch-Site: none\",\"-H\",\"Sec-Fetch-User: ?1\",\n         \"-H\",\"Upgrade-Insecure-Requests: 1\",\"-X\",method]\n    for h in (extra or []): cmd+=[\"-H\",h]\n    if data is not None: cmd+=[\"--data-binary\",data]\n    cmd.append(url)\n    r=subprocess.run(cmd,capture_output=True,text=True)\n    hdr=open(out+\".hdr\",errors=\"ignore\").read() if out else \"\"\n    mit=[l for l in hdr.splitlines() if \"vercel-mitigated\" in l.lower() or l.startswith(\"HTTP/\")]\n    return r.stdout.strip(), mit\nif __name__==\"__main__\":\n    url=sys.argv[1]; out=sys.argv[2]\n    print(get(url,out))\n    try:\n        b=open(out,errors=\"ignore\").read()\n        import re\n        m=re.search(r\"<title>([^<]*)\",b)\n        print(\"TITLE:\", m.group(1) if m else None, \"len\",len(b))\n    except Exception as e: print(e)\nPYEOF\npython3 fetch.py 'https://www.infinitycapital.bh/contact' /tmp/p1.html"}
