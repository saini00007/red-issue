{"ts": 1790743070.2069857, "decision_id": "680640604dcc", "tool": "run_shell", "allow": true, "reason": null, "target": "cd \"$WORK_PATH\"; python3 - <<'PY'\nimport json,re\nUAs=set(); n=0; fromtarget=[]\nfor l in open('oob_interactions.jsonl'):\n    try: d=json.loads(l)\n    except: continue\n    n+=1\n    if d.get('protocol')!='http': continue\n    rr=d.get('raw-request','')\n    m=re.search(r'User-Agent:\\s*([^\\r\\n]+)',rr)\n    ua=m.group(1) if m else '?'\n    UAs.add(ua)\n    # any UA that is NOT a local scanner tool = would indicate real victim/browser\n    if not re.search(r'curl|python-urllib|okhttp|Go-http|libwww|node-fetch|axios|Scanner|scanner', ua, re.I):\n        fromtarget.append((d.get('full-id'),ua))\nprint(\"total interactions:\",n)\nprint(\"distinct HTTP UAs:\", UAs)\nprint(\"\\nNON-scanner UAs (would indicate a real victim browser/server):\", fromtarget[:20])\nprint(\"count:\",len(fromtarget))\nPY"}
