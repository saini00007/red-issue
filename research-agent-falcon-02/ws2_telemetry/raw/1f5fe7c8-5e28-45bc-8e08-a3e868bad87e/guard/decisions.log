{"ts": 1790766581.014662, "decision_id": "efdf50f87be4", "tool": "run_shell", "allow": true, "reason": null, "target": "cd /work/evidence/IVFY_RL_1110 && \\\nsend() { # $1=label $2=check value $3=extra curl args\n  local L=\"$1\" CK=\"$2\"; shift 2\n  curl -s -m 45 -D \"$L.hdr\" -o \"$L.body\" -X POST https://www.infinitycapital.bh/api/send \\\n    -F 'fname=Verifier' -F 'lname=Check' -F 'areacode=973' -F 'tel=5550100' \\\n    -F 'cname=Verifier Co' -F 'subject=Test Message' \\\n    -F 'msg=Independent verification of anti-automation controls - authorized security test.' \\\n    -F \"check=$CK\" -F 'targets=' \"$@\" -w \"%{http_code}\" > \"$L.code\"\n}\necho \"### A/B honeypot: A = check empty (bot-like), B = check filled (human-like)\"\necho -n \"A check=''      -> HTTP \"; send A \"\" -H 'User-Agent: curl/8.5.0'; echo \" body: $(cat A.body)\"\necho -n \"B check='1'     -> HTTP \"; send B \"1\" -H 'User-Agent: curl/8.5.0'; echo \" body: $(cat B.body)\"\necho -n \"C check='botbotbot' -> HTTP \"; send C \"botbotbot\" -H 'User-Agent: curl/8.5.0'; echo \" body: $(cat C.body)\"\necho\necho \"### Diff A vs B vs C bodies (byte-identical => honeypot never evaluated):\"\nmd5sum A.body B.body C.body\necho \"### Any anti-automation signal in responses?\"\nfor f in A B C; do echo \"$f: $(grep -icE 'captcha|recaptcha|hcaptcha|turnstile|challenge|too many|rate limit' $f.body) matches; code=$(cat $f.code)\"; grep -iE 'x-vercel-mitigated|retry-after|ratelimit|cf-mitigated|x-ratelimit' $f.hdr || echo \"   (no rate-limit/anti-bot headers)\"; done"}
{"ts": 1790766602.6161976, "decision_id": "ac3672a134cc", "tool": "run_shell", "allow": true, "reason": null, "target": "cd /work/evidence/IVFY_RL_1110 && python3 - <<'EOF'\nimport json\ndef norm(p):\n    return json.dumps(json.load(open(p)), sort_keys=True)\na,b,c = norm('A.body'), norm('B.body'), norm('C.body')\nprint(\"check='' (bot)      :\", a)\nprint(\"check='1' (human)   :\", b)\nprint(\"check='botbotbot'   :\", c)\nprint()\nprint(\"check=''  == check='1'          ?\", a==b)\nprint(\"check=''  == check='botbotbot'  ?\", a==c)\nprint(\"=> raw md5 differs only due to JSON key ORDER, which varies randomly per upstream response.\")\nprint(\"=> Semantic response to a bot (empty honeypot) is IDENTICAL to a human (filled honeypot):\")\nprint(\"   no CAPTCHA/challenge, no 403, no 429, no silent-drop.\")\nEOF"}
