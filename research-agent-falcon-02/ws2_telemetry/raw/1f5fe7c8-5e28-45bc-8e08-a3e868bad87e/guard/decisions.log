{"ts": 1790727531.6212552, "decision_id": "2882aed79110", "tool": "run_shell", "allow": true, "reason": null, "target": "cd \"$WORK_PATH\" && python3 -c \"\nimport json,collections,re\naddr=collections.Counter(); byaddr=[]\nfor l in open('oob_interactions.jsonl'):\n    l=l.strip()\n    if not l: continue\n    try: d=json.loads(l)\n    except: continue\n    if d.get('q-type')=='dns' or 'opcode: QUERY' in (d.get('raw-request') or ''): continue\n    a=d.get('remote-address')\n    addr[a]+=1\n    raw=d.get('raw-request') or ''\n    host=re.search(r'(?im)^host:\\s*(\\S+)',raw)\n    byaddr.append((a, host.group(1) if host else '?', raw.split('\\n')[0][:50]))\nprint('HTTP callbacks by remote-address:')\nfor k,v in addr.most_common(20): print(' ',v,k)\nprint()\nprint('sample:')\nfor x in byaddr[:15]: print(x)\n\""}
