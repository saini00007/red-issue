{"ts": 1790727388.090928, "decision_id": "e09f7878ac8b", "tool": "run_shell", "allow": true, "reason": null, "target": "cd $WORK_PATH; for i in 1 2 3 4 5; do python3 -c \"\nimport net,re\nc,h,b=net.fetch('/contact',tries=10)\nif c=='200':\n    t=b.decode(errors='replace')\n    print('OK', len(t))\n    for m in re.finditer(r'<form[^>]*>', t, re.I): print('FORM:',m.group(0))\n    for kw in ['api/send','fetch(','FormData','msgTxt','areacode','telInput']:\n        i=t.find(kw)\n        print(kw,'->', t[max(0,i-60):i+200].replace(chr(10),' ')[:240] if i>=0 else 'NOT FOUND')\n    break\nelse: print('still',c)\n\" && break; done"}
