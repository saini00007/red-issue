\"5551234\",\n       \"cname\":\"QA Tester\",\"subject\":\"SecTest\",\"msg\":\"body text\",\"check\":\"on\",\n       \"targets\":RCPT}\n    d.update(over)\n    return d\nPYEOF\ncd /work/w15 && python3 -c \"import h; print('OK RCPT=',h.RCPT)\""}
