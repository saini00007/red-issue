{"ts": 1790727522.3638692, "decision_id": "25410bec3507", "tool": "run_shell", "allow": true, "reason": null, "target": "cd \"$WORK_PATH\" && python3 -c \"\nimport json,collections\nc=collections.Counter(); ids=collections.Counter()\nfor l in open('oob_interactions.jsonl'):\n    l=l.strip()\n    if not l: continue\n    try: d=json.loads(l)\n    except: continue\n    raw=d.get('raw-request') or ''\n    host='?'\n    for ln in raw.split('\\n')[:8]:\n        if ln.lower().startswith('host:'): host=ln.split(':',1)[1].strip()\n    first=raw.split('\\n')[0][:60]\n    c[(host,first)]+=1\n    ids[d.get('full-id')]+=1\nprint('uniq host+first',len(c))\nfor k,v in c.most_common(25): print(v,'|',k)\n\""}
