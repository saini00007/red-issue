{"ts": 1790727547.491439, "decision_id": "635639ce33e5", "tool": "run_shell", "allow": true, "reason": null, "target": "cd \"$WORK_PATH\" && python3 -c \"\nimport json,re,collections\n# registered hosts (hosts WE minted)\nreg=set()\nfor l in open('oob_registry.jsonl'):\n    l=l.strip()\n    if not l: continue\n    try: d=json.loads(l)\n    except: continue\n    reg.add(d.get('host') or d.get('unique_id') or '')\nprint('registered hosts:',len(reg))\ncb=[]\nfor l in open('oob_interactions.jsonl'):\n    l=l.strip()\n    if not l: continue\n    try: d=json.loads(l)\n    except: continue\n    raw=d.get('raw-request') or ''\n    if 'opcode: QUERY' in raw: continue\n    m=re.search(r'(?im)^host:\\s*(\\S+)',raw)\n    if not m: continue\n    h=m.group(1)\n    cb.append((h.split('.')[0], d.get('remote-address')))\nregshort={h.split('.')[0] for h in reg if h}\nctrl=[c for c in cb if c[0] not in regshort]\nprint('total http callbacks:',len(cb))\nprint('callbacks to UNREGISTERED (control) hosts:',len(ctrl))\nprint()\nprint('--- control-host hits by IP ---')\nc=collections.Counter(ip for h,ip in ctrl)\nfor k,v in c.most_common(): print(' ',v,k)\nprint()\nprint('--- registered-host hits by IP ---')\nc2=collections.Counter(ip for h,ip in cb if h in regshort)\nfor k,v in c2.most_common(): print(' ',v,k)\n\" 2>&1 | tail -30"}
