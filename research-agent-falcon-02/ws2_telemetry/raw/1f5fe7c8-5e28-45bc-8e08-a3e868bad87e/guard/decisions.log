{"ts": 1790731322.079722, "decision_id": "b562876a96f2", "tool": "run_shell", "allow": true, "reason": null, "target": "cd \"$WORK_PATH\"; echo \"=== tokens with interactions? sample ===\"; python3 - <<'PY'\nimport json\nreg={}\nfor l in open('oob_registry.jsonl'):\n    try: d=json.loads(l); reg[d['token']]=d\n    except: pass\ninter={}\nfor l in open('oob_interactions.jsonl'):\n    try: d=json.loads(l)\n    except: continue\n    t=d.get('token')\n    if t: inter[t]=inter.get(t,0)+1\nprint(\"registry tokens:\",len(reg),\"interacted tokens:\",len(inter))\n# which claims had callbacks\nclaimed={'oob6808dd4b32ce':'xxe /404','oob17aecfd7c311':'xxe /api/','oobce880a03ecdf':'xxe /atom.xml','oob2d43988f0966':'xxe _next/image','ooba76cef8510c5':'xxe','oob437467ad64a2':'xxe /api/send','oobe5b8c855d767':'xxe /api/','oob0239c2639eda':'xxe /?id'}\nfor t,desc in claimed.items():\n    print(f\"  {t} {desc}: interactions={inter.get(t,0)}\")\nprint(\"--- top 15 by interaction count ---\")\nfor t,c in sorted(inter.items(),key=lambda x:-x[1])[:15]:\n    d=reg.get(t,{})\n    print(f\"  {t} n={c} class={d.get('vuln_class')} ep={d.get('endpoint')} method={d.get('method')}\")\nPY"}
