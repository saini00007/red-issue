{"ts": 1790742121.5060651, "decision_id": "b4c09df0664c", "tool": "run_shell", "allow": true, "reason": null, "target": "cd $WORK_PATH; python3 - <<'EOF'\nimport json, collections\nreg={}\nfor l in open('oob_registry.jsonl'):\n    d=json.loads(l); reg[d['token']]=d\ntok_of=lambda fid: fid.split('.')[0]\nbyt=collections.defaultdict(lambda: {'dns':0,'http':0,'addrs':set(),'paths':set()})\nfor l in open('oob_interactions.jsonl'):\n    d=json.loads(l)\n    t=tok_of(d.get('full-id',''))\n    p=d.get('protocol')\n    b=byt[t]\n    if p=='http':\n        b['http']+=1\n        b['addrs'].add(d.get('remote-address'))\n        rr=d.get('raw-request','')\n        b['paths'].add(rr.split('\\r\\n')[0][:80])\n    else:\n        b['dns']+=1\n        b['addrs'].add(d.get('remote-address'))\nprint(\"total distinct tokens interacted:\", len(byt))\n# Which have HTTP interactions\nhttpt=[t for t,b in byt.items() if b['http']]\nprint(\"tokens with HTTP interactions:\", len(httpt))\nfor t in sorted(httpt):\n    b=byt[t]\n    r=reg.get(t)\n    print(t, r and r['vuln_class'], r and r['endpoint'][:70], r and r['param'], \"| http:\",b['http'], \"addrs:\",sorted(b['addrs']), \"| paths:\", list(b['paths'])[:3])\nEOF"}
