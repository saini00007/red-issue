#!/bin/bash
# Non-destructive functional probe of POST /api/send on the contact form.
BASE="https://www.infinitycapital.bh"
UA="Mozilla/5.0 (compatible; SecVerifier/1.0)"
send () {
  echo "=================================================================="
  echo "TEST: $1"
  echo "targets = [$2]"
  curl -s -o "resp_$1.json" -D "resp_$1.hdr" -X POST "$BASE/api/send" \
    -H "User-Agent: $UA" \
    -H "Origin: https://www.infinitycapital.bh" \
    -H "Referer: https://www.infinitycapital.bh/contact" \
    --max-time 45 \
    -F "fname=Verifier" -F "lname=Baseline" \
    -F "areacode=" -F "tel=+9730000" \
    -F "cname=Infinity Capital Security Verification" \
    -F "subject=Investment Opportunities" \
    -F "msg=AUTOMATED SECURITY VERIFICATION MESSAGE - non-destructive functional test. Please ignore." \
    -F "check=bot" \
    -F "targets=$2"
  echo "--- status ---"; head -1 "resp_$1.hdr"
  echo "--- body ---"; cat "resp_$1.json"; echo
}
send "T1_external_recipient"  "relay.probe.oob@oob.relay-check.invalid"
