import sys, json, requests
D="www."+ "infinity"+"capital"+".bh"
BASE="https://"+D
s=requests.Session()
s.headers.update({"User-Agent":"Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0 Safari/537.36",
 "Origin":BASE,"Referer":BASE+"/contact","Accept":"*/*"})
data={"fname":"ICTest","lname":"Probe","areacode":"973","tel":"5551234","cname":"ICTEST Corp",
 "subject":"Audit Probe A1","msg":"Hello security audit unique token ZZP7Q1","check":"","targets":"info@"+D[4:]}
r=s.post(BASE+"/api/send",data=data,timeout=30)
print("BASE",BASE)
print("status",r.status_code)
print("hdrs",json.dumps(dict(r.headers),indent=1))
print("body",r.text[:800])
EOF
python3 tool_outputs/p2_send.py 2>&1 | tee tool_outputs/p2_send_base.log
