import urllib.request
for u in ["/","/contact","/contact-us","/about","/contact/","/en"]:
    try:
        r=urllib.request.urlopen(urllib.request.Request("https://www.infinitycapital.bh"+u,headers={"User-Agent":"Mozilla/5.0"}),timeout=20)
        d=r.read(); fn="pg"+u.replace("/","_")+".html"; open(fn,"wb").write(d)
        print(r.status,u,len(d))
    except Exception as e:
        print("ERR",u,e)
EOF
